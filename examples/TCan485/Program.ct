using System;
using System.Runtime;
using Esp.Idf;

namespace Examples.TCan485;

public delegate int ValueReader();
public delegate int NativeTransformer(int value);

[NativeType("ct_esp_test_handle_t", "ctilde_esp_shim.h")]
public opaque NativeTestHandle;

public static class NativeCallback
{
    [Extern("ct_esp_invoke_i64")]
    public static unsafe long Invoke(delegate* unmanaged<long, long> callback, long value);
}

public static class NativeBufferApi
{
    [Extern("ct_esp_fill_buffer")]
    [NoAlloc]
    public static unsafe uint Fill(NativeBuffer<byte> buffer);
}

public static class NativeInterop
{
    [Extern("ct_esp_utf8_length")]
    [NoAlloc]
    public static uint Utf8Length(NativeUtf8String value);

    [Extern("ct_esp_test_resource_create")]
    [NoAlloc]
    public static EspError Create([Creates] [Nullable] out NativeTestHandle handle);

    [Extern("ct_esp_test_resource_value")]
    [NoAlloc]
    public static int Read([Borrowed] NativeTestHandle handle);

    [Extern("ct_esp_test_resource_release")]
    [NoAlloc]
    public static void Release([Consumes] [Nullable] NativeTestHandle handle);

    [Extern("ct_esp_invoke_delegate")]
    public static int Invoke([SynchronousCallback] NativeTransformer callback, int value);

    [Extern("ct_esp_call_export")]
    [NoAlloc]
    public static int CallExport(int left, int right);

    [Extern("ct_esp_threading_self_test")]
    public static int ThreadingSelfTest([SynchronousCallback] NativeTransformer callback);

    [Extern("ct_esp_thread_cleanup")]
    [NoAlloc]
    public static void ThreadCleanup(int value);
}

public class Probe
{
    public virtual int Value()
    {
        return 1;
    }
}

public sealed class DerivedProbe : Probe
{
    public override int Value()
    {
        return 42;
    }
}

public class ArcNode
{
    public ArcNode Next;
    public string Text;
}

public struct ArcHolder
{
    public ArcNode Node;
    public string Text;
}

public static class Program
{
    private const int Ws2812Pin = 4;

    private static void ExerciseArc()
    {
        ArcNode head = null;
        ArcHolder[] holders = new ArcHolder[8];
        int index = 0;
        while (index < 32)
        {
            ArcNode node = new ArcNode();
            node.Next = head;
            node.Text = index.ToString();
            head = node;
            if (index < 8)
            {
                holders[index].Node = node;
                holders[index].Text = node.Text;
            }
            index++;
        }
        object boxed = holders[0];
        string dynamicText = "arc " + head.Text;
    }

    private static long DoubleLong(long value)
    {
        return value * 2L;
    }

    private static int AddOne(int value)
    {
        return value + 1;
    }

    [Export("ctilde_add")]
    public static int Add(int left, int right)
    {
        return left + right;
    }

    [Export("ctilde_thread_probe")]
    public static int ThreadProbe(int value)
    {
        defer NativeInterop.ThreadCleanup(value);
        try
        {
            if (value < 0)
                throw new Exception("thread probe");
        }
        catch (Exception)
        {
            value = -value;
        }
        return value + 1;
    }

    private static unsafe void RunManagedSelfTests()
    {
        Console.WriteLine("C~ ESP-IDF hardware test");

        Probe probe = new DerivedProbe();
        Console.Write("virtual: ");
        Console.WriteLine(probe.Value());

        ValueReader reader = probe.Value;
        Console.Write("delegate: ");
        Console.WriteLine(reader());

        unsafe
        {
            delegate* unmanaged<long, long> callback = &DoubleLong;
            Console.Write("function pointer: ");
            Console.WriteLine(NativeCallback.Invoke(callback, 21L));
        }

        long timerStart = EspTimer.GetTimeMicroseconds();
        FreeRtos.DelayMilliseconds(1u);
        long timerEnd = EspTimer.GetTimeMicroseconds();
        if (timerEnd > timerStart)
            Console.WriteLine("timer64: ok");
        else
            Console.WriteLine("TIMER64_FAILED");

        NativeBuffer<byte> nativeBuffer = stackalloc byte[1];
        if (NativeBufferApi.Fill(nativeBuffer) == 42U && nativeBuffer[0] == (byte)42)
            Console.WriteLine("native buffer: 42");
        else
            Console.WriteLine("NATIVE_BUFFER_FAILED");

        NativeUtf8String nativeText = NativeUtf8String.Borrow("ctilde");
        if (NativeInterop.Utf8Length(nativeText) == 6u)
            Console.WriteLine("native utf8: ok");
        else
            Console.WriteLine("NATIVE_UTF8_FAILED");

        NativeTestHandle handle;
        EspError createError = NativeInterop.Create(out handle);
        defer NativeInterop.Release(handle);
        if (createError.IsSuccess && NativeInterop.Read(handle) == 42)
            Console.WriteLine("opaque defer: ok");
        else
            Console.WriteLine("OPAQUE_DEFER_FAILED");

        NativeTransformer transformer = AddOne;
        Console.Write("delegate context: ");
        Console.WriteLine(NativeInterop.Invoke(transformer, 41));

        Console.Write("export: ");
        Console.WriteLine(NativeInterop.CallExport(20, 22));

        Console.Write("threading: ");
        if (NativeInterop.ThreadingSelfTest(transformer) == 86)
            Console.WriteLine("ok");
        else
            Console.WriteLine("FAILED");

        object boxed = 7;
        Console.Write("boxed: ");
        Console.WriteLine((int)boxed);

        try
        {
            throw new Exception("caught on ESP32");
        }
        catch (Exception exception)
        {
            Console.Write("exception: ");
            Console.WriteLine(exception.Message);
        }

        uint heapBeforeArc = EspSystem.GetFreeHeapSize();
        int arcRound = 0;
        while (arcRound < 50)
        {
            ExerciseArc();
            arcRound++;
        }
        uint heapAfterArc = EspSystem.GetFreeHeapSize();
        bool arcRecovered = heapAfterArc >= heapBeforeArc || heapBeforeArc - heapAfterArc <= 512u;
        Console.Write("arc heap recovery: ");
        Console.WriteLine(arcRecovered);
        if (!arcRecovered)
        {
            int[] failure = null;
            failure[0] = 1;
        }
    }

    [EntryPoint]
    public static unsafe void Main()
    {
        EspError configureError = Ws2812.Configure(Ws2812Pin, 1u);
        if (!configureError.IsSuccess)
        {
            Console.Write("esp error: ");
            Console.WriteLine(configureError.GetName());
            return;
        }
        EspError clearError = Ws2812.Clear();
        if (!clearError.IsSuccess)
        {
            Console.WriteLine("WS2812_CONFIG_FAILED");
            return;
        }
        Console.WriteLine("esp error: ESP_OK");

        RunManagedSelfTests();

        Console.Write("free heap: ");
        Console.WriteLine(EspSystem.GetFreeHeapSize());
        Console.Write("minimum free heap: ");
        Console.WriteLine(EspSystem.GetMinimumFreeHeapSize());
        Console.Write("stack high water: ");
        Console.WriteLine(FreeRtos.GetStackHighWaterMark());
        Console.Write("tick: ");
        Console.WriteLine(FreeRtos.GetTickCount());

        Console.WriteLine("CTILDE_ESP_OK");
        bool high = false;
        int count = 0;
        while (true)
        {
            high = !high;
            bool updated = false;

            if (high) {
                count = count + 1;

                if (count == 1) {
                    updated = Ws2812.SetPixel(0u, 16u, 0u, 0u).IsSuccess && Ws2812.Refresh().IsSuccess;
                } else if (count == 2) {
                    updated = Ws2812.SetPixel(0u, 0u, 16u, 0u).IsSuccess && Ws2812.Refresh().IsSuccess;
                } else if (count == 3) {
                    updated = Ws2812.SetPixel(0u, 0u, 0u, 16u).IsSuccess && Ws2812.Refresh().IsSuccess;
                    count = 0;
                }
            }
            else
                updated = Ws2812.Clear().IsSuccess;
                
            if (!updated)
            {
                Console.WriteLine("WS2812_UPDATE_FAILED");
                return;
            }
            if (high)
                Console.WriteLine("ws2812: on");
            else
                Console.WriteLine("ws2812: off");

            FreeRtos.DelayMilliseconds(500u);
        }
    }
}
