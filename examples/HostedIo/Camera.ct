using System;
using System.Runtime;
using System.Simd;

namespace HostedIoExample;

public sealed class Camera
{
    public float AspectRatio;
    public int ImageWidth;
    public int SamplesPerPixel;
    public int MaxDepth;
    public float VerticalFieldOfView;
    public Vec3 LookFrom;
    public Vec3 LookAt;
    public Vec3 Up;
    public float DefocusAngle;
    public float FocusDistance;
    public int ProgressRows;
    private int imageHeight;
    private float sampleScale;
    private Vec3 center;
    private Vec3 pixel00Location;
    private Vec3 pixelDeltaU;
    private Vec3 pixelDeltaV;
    private Vec3 defocusDiskU;
    private Vec3 defocusDiskV;

    public Camera()
    {
        AspectRatio = 1.0f;
        ImageWidth = 100;
        SamplesPerPixel = 10;
        MaxDepth = 10;
        VerticalFieldOfView = 90.0f;
        LookFrom = Vec3.Zero;
        LookAt = new Vec3(0.0f, 0.0f, -1.0f);
        Up = Vec3.UnitY;
        DefocusAngle = 0.0f;
        FocusDistance = 10.0f;
        ProgressRows = 0;
    }

    [NoAlloc]
    public int ImageHeight
    {
        get
        {
            int height = (int)((float)ImageWidth / AspectRatio);
            if (height < 1)
                return 1;
            return height;
        }
    }

    public void Render(Rgba32[] pixels, Hittable world, uint renderSeed)
    {
        InitializeForRender();
        if (pixels.Length < ImageWidth * imageHeight)
            throw new Exception("The pixel buffer is smaller than the configured camera image.");
        PacketRandomGenerator random = new PacketRandomGenerator(renderSeed);
        int row = 0;
        int lastProgressPercent = 0;
        while (row < imageHeight)
        {
            int column = 0;
            while (column < ImageWidth)
            {
                PixelPacket packet = RenderPacket(column, row, world, renderSeed,
                    random);
                int destination = row * ImageWidth + column;
                pixels[destination] = packet.Lane0;
                if (packet.Count > 1)
                    pixels[destination + 1] = packet.Lane1;
                if (packet.Count > 2)
                    pixels[destination + 2] = packet.Lane2;
                if (packet.Count > 3)
                    pixels[destination + 3] = packet.Lane3;
                column += 4;
            }
            int completed = row + 1;
            if (ProgressRows > 0 && (completed % ProgressRows == 0 || completed == imageHeight))
            {
                int percent = completed * 100 / imageHeight;
                if (percent > lastProgressPercent)
                {
                    Console.WriteLine("Progress: " + percent.ToString() + "%.");
                    lastProgressPercent = percent;
                }
            }
            row++;
        }
    }

    [NoAlloc]
    public PixelPacket RenderPacket(int column, int row, Hittable world, uint renderSeed,
        PacketRandomGenerator random)
    {
        int laneCount = ImageWidth - column;
        if (laneCount > 4)
            laneCount = 4;
        U32x4 columns = U32x4.Create((uint)column, (uint)(column + 1), (uint)(column
            + 2), (uint)(column + 3));
        return RenderPacket(columns, U32x4.Splat((uint)row), laneCount, world, renderSeed,
            random);
    }

    [NoAlloc]
    public PixelPacket RenderPacket(U32x4 columns, U32x4 rows, int laneCount, Hittable world,
        uint renderSeed, PacketRandomGenerator random)
    {
        Mask32x4 active = PacketMasks.First(laneCount);
        Vec3x4 colors = Vec3x4.Zero;
        int sample = 0;
        while (sample < SamplesPerPixel)
        {
            random.Reseed(PacketRandomGenerator.SampleSeeds(renderSeed, columns,
                rows, sample, active));
            RayPacket rays = GetRay4(F32x4.FromU32(columns), F32x4.FromU32(rows),
                active, random);
            colors += RayColor4(ref rays, active, MaxDepth, world, random);
            sample++;
        }
        return ToPixelPacket(colors, laneCount);
    }

    // Retained as a deterministic oracle for packet-renderer acceptance tests.
    public void RenderScalar(Rgba32[] pixels, Hittable world, uint renderSeed)
    {
        InitializeForRender();
        if (pixels.Length < ImageWidth * imageHeight)
            throw new Exception("The pixel buffer is smaller than the configured camera image.");
        RandomGenerator random = new RandomGenerator(renderSeed);
        int row = 0;
        int lastProgressPercent = 0;
        while (row < imageHeight)
        {
            int column = 0;
            while (column < ImageWidth)
            {
                Vec3 color = Vec3.Zero;
                int sample = 0;
                while (sample < SamplesPerPixel)
                {
                    random.Reseed(RandomGenerator.SampleSeed(renderSeed, column,
                        row, sample));
                    Ray ray = GetRay(column, row, random);
                    color += RayColor(ray, MaxDepth, world, random);
                    sample++;
                }
                pixels[row * ImageWidth + column] = ToPixelColor(color);
                column++;
            }
            int completed = row + 1;
            if (ProgressRows > 0 && (completed % ProgressRows == 0 || completed == imageHeight))
            {
                int percent = completed * 100 / imageHeight;
                if (percent > lastProgressPercent)
                {
                    Console.WriteLine("Progress: " + percent.ToString() + "%.");
                    lastProgressPercent = percent;
                }
            }
            row++;
        }
    }

    // Untimed benchmark census. Production render paths intentionally do not count rays.
    public long CountPacketPathSegments(Hittable world, uint renderSeed)
    {
        InitializeForRender();
        PacketRandomGenerator random = new PacketRandomGenerator(renderSeed);
        long tracedSegments = 0L;
        int row = 0;
        while (row < imageHeight)
        {
            int column = 0;
            while (column < ImageWidth)
            {
                int laneCount = ImageWidth - column;
                if (laneCount > 4)
                    laneCount = 4;
                U32x4 columns = U32x4.Create((uint)column, (uint)(column + 1), (uint)(column
                    + 2), (uint)(column + 3));
                Mask32x4 active = PacketMasks.First(laneCount);
                int sample = 0;
                while (sample < SamplesPerPixel)
                {
                    random.Reseed(PacketRandomGenerator.SampleSeeds(renderSeed, columns,
                        U32x4.Splat((uint)row), sample, active));
                    RayPacket rays = GetRay4(F32x4.FromU32(columns), F32x4.Splat((float)row),
                        active, random);
                    CountRayColor4(ref rays, active, MaxDepth, world, random, ref tracedSegments);
                    sample++;
                }
                column += laneCount;
            }
            row++;
        }
        return tracedSegments;
    }

    // Untimed scalar oracle census for the scalar benchmark variant.
    public long CountScalarPathSegments(Hittable world, uint renderSeed)
    {
        InitializeForRender();
        RandomGenerator random = new RandomGenerator(renderSeed);
        long tracedSegments = 0L;
        int row = 0;
        while (row < imageHeight)
        {
            int column = 0;
            while (column < ImageWidth)
            {
                int sample = 0;
                while (sample < SamplesPerPixel)
                {
                    random.Reseed(RandomGenerator.SampleSeed(renderSeed, column,
                        row, sample));
                    Ray ray = GetRay(column, row, random);
                    CountRayColor(ray, MaxDepth, world, random, ref tracedSegments);
                    sample++;
                }
                column++;
            }
            row++;
        }
        return tracedSegments;
    }

    [NoAlloc]
    public void InitializeForRender()
    {
        imageHeight = ImageHeight;
        sampleScale = 1.0f / (float)SamplesPerPixel;
        center = LookFrom;
        float theta = VerticalFieldOfView * Math.Pi / 180.0f;
        float viewportHeight = 2.0f * Math.Tan(theta * 0.5f) * FocusDistance;
        float viewportWidth = viewportHeight * ((float)ImageWidth / (float)imageHeight);
        Vec3 viewBack = (LookFrom - LookAt).Normalize();
        Vec3 viewRight = Up.Cross(viewBack).Normalize();
        Vec3 viewUp = viewBack.Cross(viewRight);
        Vec3 viewportU = viewportWidth * viewRight;
        Vec3 viewportV = -viewportHeight * viewUp;
        pixelDeltaU = viewportU / (float)ImageWidth;
        pixelDeltaV = viewportV / (float)imageHeight;
        Vec3 viewportUpperLeft = center - FocusDistance * viewBack;
        viewportUpperLeft -= viewportU * 0.5f;
        viewportUpperLeft -= viewportV * 0.5f;
        pixel00Location = viewportUpperLeft + (pixelDeltaU + pixelDeltaV) * 0.5f;
        float defocusRadius = FocusDistance * Math.Tan(DefocusAngle * Math.Pi / 360.0f);
        defocusDiskU = viewRight * defocusRadius;
        defocusDiskV = viewUp * defocusRadius;
    }

    [NoAlloc]
    private Ray GetRay(int column, int row, RandomGenerator random)
    {
        float offsetX = random.NextFloat() - 0.5f;
        float offsetY = random.NextFloat() - 0.5f;
        Vec3 pixelSample = pixel00Location;
        pixelSample += ((float)column + offsetX) * pixelDeltaU;
        pixelSample += ((float)row + offsetY) * pixelDeltaV;
        Vec3 origin = center;
        if (DefocusAngle > 0.0f)
        {
            Vec3 diskSample = random.InUnitDisk();
            origin += diskSample.X * defocusDiskU;
            origin += diskSample.Y * defocusDiskV;
        }
        return new Ray(origin, pixelSample - origin);
    }

    [NoAlloc]
    private RayPacket GetRay4(F32x4 columns, F32x4 rows, Mask32x4 active, PacketRandomGenerator random)
    {
        F32x4 offsetX = random.NextFloat(active) - F32x4.Splat(0.5f);
        F32x4 offsetY = random.NextFloat(active) - F32x4.Splat(0.5f);
        Vec3x4 pixelSample = Vec3x4.Splat(pixel00Location);
        pixelSample += Vec3x4.Splat(pixelDeltaU) * (columns + offsetX);
        pixelSample += Vec3x4.Splat(pixelDeltaV) * (rows + offsetY);
        Vec3x4 origins = Vec3x4.Splat(center);
        if (DefocusAngle > 0.0f)
        {
            Vec3x4 diskSample = random.InUnitDisk(active);
            origins += Vec3x4.Splat(defocusDiskU) * diskSample.X;
            origins += Vec3x4.Splat(defocusDiskV) * diskSample.Y;
        }
        return new RayPacket(origins, pixelSample - origins);
    }

    [NoAlloc]
    private Vec3x4 RayColor4(ref RayPacket rays, Mask32x4 active, int depth, Hittable world,
        PacketRandomGenerator random)
    {
        Vec3x4 result = Vec3x4.Zero;
        if (depth <= 0 || active.None())
            return result;
        HitPacket hits;
        RayInterval4 interval = RayInterval4.Splat(0.001f, 1000000000000000000000000000000.0f);
        world.Hit4(ref rays, ref interval, active, out hits);
        Mask32x4 misses = Mask32x4.AndNot(hits.HitMask, active);
        result = Vec3x4.Select(misses, SkyColor4(ref rays), result);
        Vec3x4 attenuation;
        RayPacket scattered;
        Mask32x4 scatteredMask = PacketMaterials.Scatter(ref rays, ref hits, hits.HitMask,
            random, out attenuation, out scattered);
        if (scatteredMask.Any())
        {
            Vec3x4 bounced = RayColor4(ref scattered, scatteredMask, depth - 1, world,
                random);
            result = Vec3x4.Select(scatteredMask, attenuation * bounced, result);
        }
        return result;
    }

    [NoAlloc]
    private Vec3 RayColor(Ray ray, int depth, Hittable world, RandomGenerator random)
    {
        if (depth <= 0)
            return Vec3.Zero;
        HitRecord hit;
        bool hasHit = world.Hit(ray, new Interval(0.001f, 1000000000000000000000000000000.0f),
            out hit);
        if (hasHit)
        {
            Vec3 attenuation;
            Ray scattered;
            bool didScatter = hit.SurfaceMaterial.Scatter(ray, hit, random, out attenuation,
                out scattered);
            if (didScatter)
                return attenuation * RayColor(scattered, depth - 1, world, random);
            return Vec3.Zero;
        }
        return SkyColor(ray);
    }

    [NoAlloc]
    private void CountRayColor4(ref RayPacket rays, Mask32x4 active, int depth, Hittable world,
        PacketRandomGenerator random, ref long tracedSegments)
    {
        if (depth <= 0 || active.None())
            return;
        tracedSegments += (long)Cpu.PopCount(active.MoveMask());
        HitPacket hits;
        RayInterval4 interval = RayInterval4.Splat(0.001f, 1000000000000000000000000000000.0f);
        world.Hit4(ref rays, ref interval, active, out hits);
        Vec3x4 attenuation;
        RayPacket scattered;
        Mask32x4 scatteredMask = PacketMaterials.Scatter(ref rays, ref hits, hits.HitMask,
            random, out attenuation, out scattered);
        if (scatteredMask.Any())
            CountRayColor4(ref scattered, scatteredMask, depth - 1, world, random,
            ref tracedSegments);
    }

    [NoAlloc]
    private void CountRayColor(Ray ray, int depth, Hittable world, RandomGenerator random,
        ref long tracedSegments)
    {
        if (depth <= 0)
            return;
        tracedSegments++;
        HitRecord hit;
        bool hasHit = world.Hit(ray, new Interval(0.001f, 1000000000000000000000000000000.0f),
            out hit);
        if (!hasHit)
            return;
        Vec3 attenuation;
        Ray scattered;
        bool didScatter = hit.SurfaceMaterial.Scatter(ray, hit, random, out attenuation,
            out scattered);
        if (didScatter)
            CountRayColor(scattered, depth - 1, world, random, ref tracedSegments);
    }

    [NoAlloc]
    private static Vec3 SkyColor(Ray ray)
    {
        Vec3 unitDirection = ray.Direction.Normalize();
        float blend = 0.5f * (unitDirection.Y + 1.0f);
        return(1.0f - blend) * Vec3.One + blend * new Vec3(0.5f, 0.7f, 1.0f);
    }

    [NoAlloc]
    private static Vec3x4 SkyColor4(ref RayPacket rays)
    {
        Vec3x4 unitDirection = rays.Directions.Normalize();
        F32x4 blend = F32x4.Splat(0.5f) * (unitDirection.Y + F32x4.Splat(1.0f));
        return Vec3x4.Splat(Vec3.One) * (F32x4.Splat(1.0f) - blend) + Vec3x4.Splat(new Vec3(0.5f,
            0.7f, 1.0f)) * blend;
    }

    [NoAlloc]
    private Rgba32 ToPixelColor(Vec3 accumulated)
    {
        int red = ToColorByte(LinearToGamma(accumulated.X * sampleScale));
        int green = ToColorByte(LinearToGamma(accumulated.Y * sampleScale));
        int blue = ToColorByte(LinearToGamma(accumulated.Z * sampleScale));
        return new Rgba32((byte)red, (byte)green, (byte)blue, (byte)255);
    }

    [NoAlloc]
    private PixelPacket ToPixelPacket(Vec3x4 accumulated, int laneCount)
    {
        Rgba32 black = Rgba32.Black();
        Rgba32 lane0 = black;
        Rgba32 lane1 = black;
        Rgba32 lane2 = black;
        Rgba32 lane3 = black;
        if (laneCount > 0)
            lane0 = ToPixelColor(accumulated.GetLane<0>());
        if (laneCount > 1)
            lane1 = ToPixelColor(accumulated.GetLane<1>());
        if (laneCount > 2)
            lane2 = ToPixelColor(accumulated.GetLane<2>());
        if (laneCount > 3)
            lane3 = ToPixelColor(accumulated.GetLane<3>());
        return new PixelPacket(lane0, lane1, lane2, lane3, laneCount);
    }

    [NoAlloc]
    private static float LinearToGamma(float value)
    {
        if (value > 0.0f)
            return Math.Sqrt(value);
        return 0.0f;
    }

    [NoAlloc]
    private static int ToColorByte(float value)
    {
        return(int)(256.0f * new Interval(0.0f, 0.999f).Clamp(value));
    }
}
