namespace System.Diagnostics;

internal static class MonotonicClock
{
    [Extern("ct_monotonic_nanoseconds")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static long GetTimestampNanoseconds();
}

public struct Stopwatch
{
    private long startedAtNanoseconds;
    private long accumulatedNanoseconds;
    private bool running;

    public Stopwatch()
    {
        startedAtNanoseconds = 0L;
        accumulatedNanoseconds = 0L;
        running = false;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public static Stopwatch StartNew()
    {
        Stopwatch result = new Stopwatch();
        result.Start();
        return result;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public static long GetTimestampNanoseconds()
    {
        return MonotonicClock.GetTimestampNanoseconds();
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public bool IsRunning
    {
        get
        {
            return running;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public TimeSpan Elapsed
    {
        get
        {
            return TimeSpan.FromNanoseconds(CurrentElapsedNanoseconds());
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public long ElapsedNanoseconds
    {
        get
        {
            return CurrentElapsedNanoseconds();
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public long ElapsedMilliseconds
    {
        get
        {
            return CurrentElapsedNanoseconds() / TimeSpan.NanosecondsPerMillisecond;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public void Start()
    {
        if (!running)
        {
            startedAtNanoseconds = GetTimestampNanoseconds();
            running = true;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public void Stop()
    {
        if (running)
        {
            accumulatedNanoseconds += GetTimestampNanoseconds() - startedAtNanoseconds;
            running = false;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public void Reset()
    {
        startedAtNanoseconds = 0L;
        accumulatedNanoseconds = 0L;
        running = false;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public void Restart()
    {
        accumulatedNanoseconds = 0L;
        startedAtNanoseconds = GetTimestampNanoseconds();
        running = true;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    private long CurrentElapsedNanoseconds()
    {
        if (running)
        {
            return accumulatedNanoseconds + GetTimestampNanoseconds() - startedAtNanoseconds;
        }
        return accumulatedNanoseconds;
    }
}

public enum ProcessState
{
    Starting, Running, Cancelling, Exited, Failed, Terminated
}

internal static class ProcessRuntime
{
    [Extern("ct_managed_process_start")]
    internal static nuint Start(string path, string[] args);

    [Extern("ct_managed_process_start_redirected")]
    internal static nuint StartRedirected(string path, string[] args, bool redirectInput,
        bool redirectOutput, bool redirectError);

    [Extern("ct_managed_process_try_open")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static nuint TryOpen(uint id);

    [Extern("ct_managed_process_pipe_read")]
    internal static bool PipeRead(nuint handle, int stream, byte[] buffer, int offset,
        int count, uint timeoutMilliseconds, out int bytesRead, out bool eof);

    [Extern("ct_managed_process_pipe_write")]
    internal static bool PipeWrite(nuint handle, int stream, byte[] buffer, int offset,
        int count, uint timeoutMilliseconds, out int bytesWritten);

    [Extern("ct_managed_process_pipe_close")]
    [NoAlloc]
    [NoThrow]
    internal static void PipeClose(nuint handle, int stream);

    [Extern("ct_managed_process_current")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static nuint Current();

    [Extern("ct_managed_process_id")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static uint Id(nuint handle);

    [Extern("ct_managed_process_get_state")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static ProcessState State(nuint handle);

    [Extern("ct_managed_process_has_exited")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static bool HasExited(nuint handle);

    [Extern("ct_managed_process_exit_code")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static int ExitCode(nuint handle);

    [Extern("ct_managed_process_cancel")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static void Cancel(nuint handle);

    [Extern("ct_managed_process_terminate")]
    internal static void Terminate(nuint handle, uint graceMilliseconds);

    [Extern("ct_managed_process_wait")]
    internal static int Wait(nuint handle);

    [Extern("ct_managed_process_try_wait")]
    internal static bool TryWait(nuint handle, uint timeoutMilliseconds, out int exitCode);

    [Extern("ct_managed_process_send")]
    internal static void Send(nuint handle, byte[] payload);

    [Extern("ct_managed_process_receive")]
    internal static byte[] Receive(nuint handle, byte[] typeTemplate);

    [Extern("ct_managed_process_try_receive")]
    internal static bool TryReceive(nuint handle, uint timeoutMilliseconds, byte[] typeTemplate,
        out byte[] payload);

    [Extern("ct_managed_process_cancellation_requested")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    internal static bool CancellationRequested();
}

public sealed class ProcessStartInfo
{
    public string FileName;
    public string[] Arguments;
    public bool RedirectStandardInput;
    public bool RedirectStandardOutput;
    public bool RedirectStandardError;

    public ProcessStartInfo(string fileName, string[] arguments)
    {
        if (fileName == null)
            throw new ArgumentNullException();
        if (arguments == null)
            throw new ArgumentNullException();
        FileName = fileName;
        Arguments = arguments;
        RedirectStandardInput = false;
        RedirectStandardOutput = false;
        RedirectStandardError = false;
    }
}

public sealed class ProcessPipeReader
{
    private nuint handle;
    private int stream;

    internal ProcessPipeReader(nuint handle, int stream)
    {
        this.handle = handle;
        this.stream = stream;
    }

    public bool TryRead(byte[] buffer, int offset, int count, uint timeoutMilliseconds,
        out int bytesRead, out bool eof)
    {
        if (buffer == null)
            throw new ArgumentNullException();
        if (offset < 0 || count < 0 || offset > buffer.Length - count)
            throw new ArgumentOutOfRangeException();
        bytesRead = 0;
        eof = false;
        return ProcessRuntime.PipeRead(handle, stream, buffer, offset, count, timeoutMilliseconds,
            out bytesRead, out eof);
    }

    public void Close()
    {
        ProcessRuntime.PipeClose(handle, stream);
    }
}

public sealed class ProcessPipeWriter
{
    private nuint handle;
    private int stream;

    internal ProcessPipeWriter(nuint handle, int stream)
    {
        this.handle = handle;
        this.stream = stream;
    }

    public bool TryWrite(byte[] buffer, int offset, int count, uint timeoutMilliseconds,
        out int bytesWritten)
    {
        if (buffer == null)
            throw new ArgumentNullException();
        if (offset < 0 || count < 0 || offset > buffer.Length - count)
            throw new ArgumentOutOfRangeException();
        bytesWritten = 0;
        return ProcessRuntime.PipeWrite(handle, stream, buffer, offset, count, timeoutMilliseconds,
            out bytesWritten);
    }

    public void Close()
    {
        ProcessRuntime.PipeClose(handle, stream);
    }
}

public sealed class Process
{
    private nuint handle;
    private ProcessPipeWriter standardInput;
    private ProcessPipeReader standardOutput;
    private ProcessPipeReader standardError;

    private Process(nuint handle)
    {
        this.handle = handle;
        standardInput = null;
        standardOutput = null;
        standardError = null;
    }

    public static Process Start(string path, string[] args)
    {
        if (path == null)
            throw new ArgumentNullException();
        if (args == null)
            throw new ArgumentNullException();
        return new Process(ProcessRuntime.Start(path, args));
    }

    public static Process Start(ProcessStartInfo startInfo)
    {
        if (startInfo == null)
            throw new ArgumentNullException();
        nuint value = ProcessRuntime.StartRedirected(startInfo.FileName, startInfo.Arguments,
            startInfo.RedirectStandardInput, startInfo.RedirectStandardOutput, startInfo.RedirectStandardError);
        Process process = new Process(value);
        if (startInfo.RedirectStandardInput)
            process.standardInput = new ProcessPipeWriter(value, 0);
        if (startInfo.RedirectStandardOutput)
            process.standardOutput = new ProcessPipeReader(value, 1);
        if (startInfo.RedirectStandardError)
            process.standardError = new ProcessPipeReader(value, 2);
        return process;
    }

    public static bool TryOpen(uint id, out Process process)
    {
        nuint value = ProcessRuntime.TryOpen(id);
        if (value == 0U)
        {
            process = null;
            return false;
        }
        process = new Process(value);
        return true;
    }

    public ProcessPipeWriter StandardInput
    {
        get
        {
            return standardInput;
        }
    }

    public ProcessPipeReader StandardOutput
    {
        get
        {
            return standardOutput;
        }
    }

    public ProcessPipeReader StandardError
    {
        get
        {
            return standardError;
        }
    }

    public static Process Current
    {
        get
        {
            nuint current = ProcessRuntime.Current();
            if (current == 0U)
                return null;
            return new Process(current);
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public uint Id
    {
        get
        {
            return ProcessRuntime.Id(handle);
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public ProcessState State
    {
        get
        {
            return ProcessRuntime.State(handle);
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public bool HasExited
    {
        get
        {
            return ProcessRuntime.HasExited(handle);
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public int ExitCode
    {
        get
        {
            return ProcessRuntime.ExitCode(handle);
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public void Cancel()
    {
        ProcessRuntime.Cancel(handle);
    }

    public void Terminate(uint graceMilliseconds)
    {
        ProcessRuntime.Terminate(handle, graceMilliseconds);
    }

    public void Terminate(TimeSpan gracePeriod)
    {
        double milliseconds = gracePeriod.TotalMilliseconds;
        if (milliseconds < 0.0 || milliseconds > 4294967295.0)
            throw new ArgumentOutOfRangeException();
        ProcessRuntime.Terminate(handle, (uint)milliseconds);
    }

    public int Wait()
    {
        return ProcessRuntime.Wait(handle);
    }

    public bool Wait(uint timeoutMilliseconds, out int exitCode)
    {
        exitCode = 0;
        return ProcessRuntime.TryWait(handle, timeoutMilliseconds, out exitCode);
    }

    public void Send(byte[] payload)
    {
        if (payload == null)
            throw new ArgumentNullException();
        ProcessRuntime.Send(handle, payload);
    }

    public byte[] Receive()
    {
        if (handle == 0U || ProcessRuntime.Current() != handle)
            throw new InvalidOperationException();
        return ProcessRuntime.Receive(handle, new byte[0]);
    }

    public bool TryReceive(uint timeoutMilliseconds, out byte[] payload)
    {
        payload = new byte[0];
        return ProcessRuntime.TryReceive(handle, timeoutMilliseconds, new byte[0],
            out payload);
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    public static bool IsCancellationRequested
    {
        get
        {
            return ProcessRuntime.CancellationRequested();
        }
    }
}
