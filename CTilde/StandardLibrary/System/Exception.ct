namespace System;

public class Exception
{
    private string message;

    public Exception() : this("")
    {
    }

    public Exception(string message) : base()
    {
        if (message == null)
            this.message = "";
        else
            this.message = message;
    }

    public string Message
    {
        get
        {
            return message;
        }
    }

    public override string ToString()
    {
        string typeName = base.ToString();
        if (message == null || message.Length == 0)
            return typeName;
        return typeName + ": " + message;
    }
}

public sealed class NullReferenceException : Exception
{
    public NullReferenceException() : base("Object reference is null.")
    {
    }
}

public sealed class IndexOutOfRangeException : Exception
{
    public IndexOutOfRangeException() : base("Index is outside the valid range.")
    {
    }
}

public sealed class DivideByZeroException : Exception
{
    public DivideByZeroException() : base("Integer division by zero.")
    {
    }
}

public sealed class InvalidCastException : Exception
{
    public InvalidCastException() : base("The value has an incompatible runtime type.")
    {
    }
}

public sealed class OverflowException : Exception
{
    public OverflowException() : base("A checked size operation overflowed.")
    {
    }
}

public sealed class ArgumentException : Exception
{
    public ArgumentException() : base("An argument is invalid.")
    {
    }
}

public sealed class ArgumentNullException : Exception
{
    public ArgumentNullException() : base("A required argument is null.")
    {
    }
}

public sealed class FormatException : Exception
{
    public FormatException() : base("The input string has an invalid format.")
    {
    }
}

public sealed class ArgumentOutOfRangeException : Exception
{
    public ArgumentOutOfRangeException() : base("An argument is outside the valid range.")
    {
    }
}

public sealed class InvalidOperationException : Exception
{
    public InvalidOperationException() : base("The operation is not valid for the current state.")
    {
    }
}

public sealed class KeyNotFoundException : Exception
{
    public KeyNotFoundException() : base("The requested key was not found.")
    {
    }
}

public sealed class OutOfMemoryException : Exception
{
    public OutOfMemoryException() : base("Managed allocation failed.")
    {
    }
}

public sealed class ThreadStateException : Exception
{
    public ThreadStateException() : base("The thread is in an invalid state for this operation.")
    {
    }
}

public sealed class SynchronizationLockException : Exception
{
    public SynchronizationLockException() : base("The current thread does not own the mutex.")
    {
    }
}
