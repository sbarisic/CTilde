    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public uint GetLane<const int Lane>()
    {
        if (Lane == 0)
        {
            return l0;
        }
        else if (Lane == 1)
        {
            return l1;
        }
        else if (Lane == 2)
        {
            return l2;
        }
        else
        {
            return l3;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public U32x4 WithLane<const int Lane>(uint value)
    {
        if (Lane == 0)
        {
            return new U32x4(value, l1, l2, l3);
        }
        else if (Lane == 1)
        {
            return new U32x4(l0, value, l2, l3);
        }
        else if (Lane == 2)
        {
            return new U32x4(l0, l1, value, l3);
        }
        else
        {
            return new U32x4(l0, l1, l2, value);
        }
    }

