using System;
using System.Runtime;

[Packed(4)]
public readonly struct MultibootHeader
{
    public readonly uint Magic;
    public readonly uint Flags;
    public readonly uint Checksum;

    public MultibootHeader(uint magic, uint flags, uint checksum)
    {
        Magic = magic;
        Flags = flags;
        Checksum = checksum;
    }
}

public static class BootImage
{
    [ConstInit]
    [Used]
    [Section(".multiboot")]
    [Align(4)]
    private static readonly MultibootHeader Header = new MultibootHeader(0x1BADB002u,
        0x00000003u, 0u - 0x1BADB002u - 0x00000003u);

    static assert(sizeof(MultibootHeader) == 12u);
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    private static unsafe asm void DebugWrite(char value)(in("a") value as output)
    {
        outb output, $0xe9
    }

    [RuntimeImpl(Runtime.ConsoleWrite)]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    private static unsafe RuntimeTransferResult ConsoleWrite(ReadOnlyNativeBuffer<byte> value)
    {
        for (int index = 0; (nuint)index < value.Length; index++)
            DebugWrite((char)value.Pointer[index]);
        return new RuntimeTransferResult(RuntimeStatus.Success, 0, value.Length);
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    private static unsafe asm void Exit(uint code)(in("a") code as status)
    {
        outl status, $0xf4
    }

    [RuntimeImpl(Runtime.Panic)]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    private static unsafe void Panic(RuntimePanicInfo info)
    {
        Exit(1u);
        while (true)
            Cpu.Pause();
    }

    [Export("kernel_main")]
    [NoAlloc]
    public static unsafe int Main()
    {
        Console.Write("CTILDE_QEMU_OK\n");
        return 0;
    }

    [Naked]
    [Export("_start")]
    [NoAlloc]
    public static unsafe asm void Start()
    {
        cli
        cld
        movl $stack_top, %esp
        xorl %ebp, %ebp
        call ct_runtime_initialize
        call kernel_main
        movl %eax, %ebx
        call ct_runtime_shutdown
        movl %ebx, %eax
        outl %eax, $0xf4
    1:
        hlt
        jmp 1b
    }
}
