using System;

namespace HostedNativeImportExample;

public static class ExamplePlugin
{
    [NativeImport("ctilde_example_plugin", "ctilde_plugin_api_version")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int ApiVersion();

    [NativeImport("ctilde_example_plugin", "ctilde_plugin_add")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int Add(int left, int right);

    [NativeImport("ctilde_example_plugin", "ctilde_plugin_next")]
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int Next();
}

public static class Program
{
    [EntryPoint]
    public static void Main()
    {
        int apiVersion = ExamplePlugin.ApiVersion();
        int sum = ExamplePlugin.Add(19, 23);
        int first = ExamplePlugin.Next();
        int second = ExamplePlugin.Next();
        if (apiVersion != 1 || sum != 42 || first != 1 || second != 2)
            throw new Exception("The dynamically loaded plug-in returned an invalid result.");
        Console.WriteLine("native module api: " + apiVersion.ToString());
        Console.WriteLine("native module sum: " + sum.ToString());
        Console.WriteLine("native module state: " + first.ToString());
        Console.WriteLine("native module state: " + second.ToString());
    }
}
