using System;
using System.Runtime;

namespace Examples.TCan485.Draft019;

static assert(Target.Profile == TargetProfile.EspIdf, "Draft 0.19 hardware validation requires ESP-IDF");
static assert(Target.PointerSize == 4, "ESP32 pointers must be 32 bits");
public newtype HardwareCounter : uint;

[Align(64)]
public struct ValidationBuffer<const int Capacity>
{
    public uint[Capacity] Values;
}

public static class Program
{
    [NoRecursion]
    private static uint Transform<const int Rotate>(uint value)
    {
        Cpu.MemoryBarrier();
        Cpu.Pause();
        return Cpu.ByteSwap(value) + (uint)Rotate;
    }

    [EntryPoint]
    public static void Main()
    {
        [Align(32)]
        ValidationBuffer<4> buffer = new ValidationBuffer<4>();
        buffer.Values[0] = Transform<4>(0x01020304u);
        buffer.Values[1] = (uint)Cpu.PopCount(buffer.Values[0]);
        buffer.Values[2] = (uint)Cpu.LeadingZeroCount((uint)0);
        HardwareCounter counter = (HardwareCounter)(uint)buffer.Values.Length;
        static if (Target.Architecture == TargetArchitecture.Xtensa)
        {
            if (buffer.Values[0] == 0x04030205u && buffer.Values[1] == 6u && buffer.Values[2]
                == 32u && (uint)counter == 4u)
                Console.WriteLine("CTILDE_DRAFT_019_OK");
            else
                Console.WriteLine("CTILDE_DRAFT_019_FAILED");
        }
        else
        {
            ArchitectureApiUnavailableOnEsp32.Fail();
        }
        while (true)
            Esp.Idf.FreeRtos.DelayMilliseconds(1000u);
    }
}
