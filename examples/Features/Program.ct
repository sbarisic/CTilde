using System;
using System.Runtime;

namespace Examples;

public delegate long LongTransformer(long value);

public delegate int IntTransformer(int value);

[NativeType("uintptr_t", "stdint.h")]
public opaque NativeResource;

public enum Direction : byte
{
    North=0, East=1, South=2, West=3
}

public struct Point
{
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        X = x;
        Y = y;
    }

    public int Sum()
    {
        return X + Y;
    }
}

public sealed class Counter
{
    private int value;

    public Counter(int initialValue)
    {
        value = initialValue;
    }

    public int Value
    {
        get
        {
            return value;
        }
        private set
        {
            this.value = value;
        }
    }

    public void Increment()
    {
        value++;
    }

    public int Add(int delta)
    {
        return value + delta;
    }
}

public static class NativeInterop
{
    [Extern("ct_native_utf8_length")]
    [NoAlloc]
    public static uint Utf8Length(NativeUtf8String value);

    [Extern("ct_native_resource_create")]
    [NoAlloc]
    public static int Create(
        [Creates]
        out NativeResource resource);

    [Extern("ct_native_resource_value")]
    [NoAlloc]
    public static int Read(
        [Borrowed]
        NativeResource resource);

    [Extern("ct_native_resource_release")]
    [NoAlloc]
    public static void Release(
        [Consumes]
        NativeResource resource);

    [Extern("ct_native_invoke_delegate")]
    public static int Invoke(
        [SynchronousCallback]
        IntTransformer callback, int value);

    [Extern("ct_native_call_export")]
    [NoAlloc]
    public static int CallExport(int left, int right);
}

public static class Program
{
    private const int Factor = 2;
    private static int seed = 7;

    [NoAlloc]
    private static int Twice(int value)
    {
        return value * 2;
    }

    [NoAlloc]
    private static uint Twice(uint value)
    {
        return value * 2u;
    }

    [NoAlloc]
    private static long TransformLong(long value)
    {
        return value + 1L;
    }

    [NoAlloc]
    private static void UpdateNative(ref int value, in int delta, out uint result)
    {
        value = value + delta;
        result = (uint)value;
    }

    [Extern("ct_native_buffer_sum")]
    [NoAlloc]
    private static unsafe uint NativeBufferSum(ReadOnlyNativeBuffer<byte> buffer);

    /// <summary>Adds two values for managed and exported callers.</summary>
    /// <param name="left">The first value.</param>
    /// <param name="right">The second value.</param>
    /// <returns>The sum of <paramref name="left"/> and <paramref name="right"/>.</returns>
    [Export("ctilde_add")]
    public static int Add(int left, int right)
    {
        return left + right;
    }

    [NoAlloc]
    private static void ShowDeferredCleanup()
    {
        defer Console.WriteLine("deferred");
        Console.WriteLine("Before deferred, i hope?");
    }

    [EntryPoint]
    public static void Main()
    {
        Console.WriteLine(seed * Factor);
        Counter counter = new Counter(3);
        counter.Increment();
        Console.WriteLine(counter.Value);
        int[] values = new int[3];
        for (int index = 0; index < values.Length; index++)
        {
            values[index] = index + 1;
        }
        int total = 0;
        foreach (int value in values)
        {
            total += value;
        }
        Console.WriteLine(Twice(total));
        Point point = new Point(2, 4);
        Console.WriteLine(point.Sum());
        Direction direction = Direction.East;
        switch (direction)
        {
            case Direction.North:
                Console.WriteLine("north");
                break;
            case Direction.East:
                Console.WriteLine("east");
                break;
            default:
                Console.WriteLine("other");
                break;
        }
        string text = "A" + "B";
        Console.WriteLine(text.Length);
        Console.WriteLine(text[0]);
        if (text.Length < 10)
        {
            Console.WriteLine("Text.Length < 10!");
        }
        unsafe
        {
            int number = 9;
            int* pointer = &number;
            *pointer = 10;
            Console.WriteLine(number);
            delegate* unmanaged<long, long> callback = &TransformLong;
            Console.WriteLine(callback(41L));
        }
        long signedBoundary = -9223372036854775808L;
        ulong unsignedBoundary = 18446744073709551615UL;
        Console.WriteLine(signedBoundary);
        Console.WriteLine(unsignedBoundary);
        LongTransformer transformer = TransformLong;
        Console.WriteLine(transformer(41L));
        nint nativeValue = 40;
        nuint nativeDelta = 2U;
        Console.WriteLine(nativeValue + (nint)nativeDelta);
        int updated = 40;
        readonly int delta = 2;
        uint updateResult;
        UpdateNative(ref updated, in delta, out updateResult);
        Console.WriteLine(updateResult);
        unsafe
        {
            NativeBuffer<byte> buffer = stackalloc byte[2];
            buffer[0] = (byte)40;
            buffer[1] = (byte)2;
            ReadOnlyNativeBuffer<byte> readable = buffer;
            Console.WriteLine(NativeBufferSum(readable));
        }
        NativeUtf8String nativeText = NativeUtf8String.Borrow("ctilde");
        Console.WriteLine(NativeInterop.Utf8Length(nativeText));
        NativeResource resource;
        int createResult = NativeInterop.Create(out resource);
        defer NativeInterop.Release(resource);
        Console.WriteLine(createResult + NativeInterop.Read(resource));
        IntTransformer nativeDelegate = counter.Add;
        Console.WriteLine(NativeInterop.Invoke(nativeDelegate, 38));
        Console.WriteLine(NativeInterop.CallExport(20, 22));
        ShowDeferredCleanup();
    }
}
