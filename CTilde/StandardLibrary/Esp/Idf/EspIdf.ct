namespace Esp.Idf;

public readonly struct EspError
{
    [NoAlloc]
    public int Code
    {
        get
        {
            return 0;
        }
    }

    [NoAlloc]
    public bool IsSuccess
    {
        get
        {
            return false;
        }
    }

    public string GetName()
    {
        return EspErrorRuntime.GetName(Code);
    }

    public void ThrowIfError()
    {
        if (!IsSuccess)
            throw new System.Exception(GetName() + " (" + Code.ToString() + ")");
    }
}

internal static class EspErrorRuntime
{
    [Extern("ct_esp_error_name")]
    public static string GetName(int code);
}

public static class FreeRtos
{
    [Extern("ct_esp_delay_ms")]
    [NoAlloc]
    public static void DelayMilliseconds(uint milliseconds);

    [Extern("ct_esp_tick_count")]
    [NoAlloc]
    public static uint GetTickCount();

    [Extern("ct_esp_stack_high_water_mark")]
    [NoAlloc]
    public static uint GetStackHighWaterMark();
}

public static class EspSystem
{
    [Extern("ct_esp_restart")]
    [NoAlloc]
    public static void Restart();

    [Extern("ct_esp_free_heap_size")]
    [NoAlloc]
    public static uint GetFreeHeapSize();

    [Extern("ct_esp_minimum_free_heap_size")]
    [NoAlloc]
    public static uint GetMinimumFreeHeapSize();
}

public static class EspTimer
{
    [Extern("ct_esp_timer_get_time_us")]
    [NoAlloc]
    public static long GetTimeMicroseconds();
}

public static class Gpio
{
    [Extern("ct_esp_gpio_configure_input")]
    [NoAlloc]
    public static EspError ConfigureInput(int pin);

    [Extern("ct_esp_gpio_configure_output")]
    [NoAlloc]
    public static EspError ConfigureOutput(int pin);

    [Extern("ct_esp_gpio_write")]
    [NoAlloc]
    public static EspError Write(int pin, bool high);

    [Extern("ct_esp_gpio_read")]
    [NoAlloc]
    public static bool Read(int pin);
}

public static class Ws2812
{
    [Extern("ct_esp_ws2812_configure")]
    public static EspError Configure(int pin, uint ledCount);

    [Extern("ct_esp_ws2812_set_pixel")]
    [NoAlloc]
    public static EspError SetPixel(uint index, uint red, uint green, uint blue);

    [Extern("ct_esp_ws2812_refresh")]
    [NoAlloc]
    public static EspError Refresh();

    [Extern("ct_esp_ws2812_clear")]
    [NoAlloc]
    public static EspError Clear();
}
