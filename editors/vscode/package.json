{
  "name": "ctilde-language",
  "displayName": "C~ Language Support",
  "description": "C~ syntax and semantic highlighting, diagnostics, completion, and navigation.",
  "version": "0.2.0",
  "publisher": "ctilde",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbarisic/CTilde.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ctilde",
    "onUri:ctilde-stdlib"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "C~",
    "CTilde",
    "language",
    "syntax highlighting"
  ],
  "files": [
    "LICENSE",
    "language-configuration.json",
    "syntaxes/ctilde.tmLanguage.json",
    "schemas/ctilde.schema.json",
    "out/extension.js",
    "server/**"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('server',{recursive:true,force:true})\"",
    "compile": "tsc -p ./tsconfig.json --noEmit && esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=./out/extension.js && esbuild ./src/serverDevelopment.ts --bundle --platform=node --format=cjs --outfile=./out/serverDevelopment.js && esbuild ./src/test/runTest.ts --bundle --platform=node --format=cjs --packages=external --outfile=./out/test/runTest.js && esbuild ./src/test/suite/index.ts --bundle --platform=node --format=cjs --external:vscode --packages=external --outfile=./out/test/suite/index.js",
    "build:server": "dotnet publish ../../CTilde.LanguageServer/CTilde.LanguageServer.csproj -c Release --no-self-contained -o ./server",
    "build": "npm run compile && npm run build:server",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && npm run test:client && npm run test:metadata && npm run test:grammar && npm run test:sources && npm run build:server && npm run test:server",
    "test:client": "node --test ./tests/server-development.test.mjs",
    "test:metadata": "node --test ./tests/metadata.test.mjs",
    "test:grammar": "vscode-tmgrammar-test \"tests/**/*.test.ct\"",
    "test:sources": "node --test ./tests/source-tokenization.test.mjs",
    "test:server": "node --test ./tests/language-server.test.mjs",
    "test:extension": "npm run build && node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.3",
    "typescript": "5.8.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "ctilde.languageServer.restart",
        "title": "C~: Restart Language Server"
      },
      {
        "command": "ctilde.languageServer.showOutput",
        "title": "C~: Show Language Server Output"
      }
    ],
    "configuration": {
      "title": "C~",
      "properties": {
        "ctilde.languageServer.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine",
          "description": "Path to the .NET 10 host used to run the C~ language server."
        },
        "ctilde.languageServer.serverPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Development override for the C~ language-server DLL. Accepts an absolute path, a workspace-relative path, or ${workspaceFolder}. Leave empty to use the server bundled with the extension."
        },
        "ctilde.languageServer.restartOnServerChange": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically restart an external development language server when its DLL or adjacent CTilde.Compiler.dll changes."
        },
        "ctilde.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication with the C~ language server."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/ctilde.json",
        "url": "./schemas/ctilde.schema.json"
      }
    ],
    "languages": [
      {
        "id": "ctilde",
        "aliases": [
          "C~",
          "CTilde"
        ],
        "extensions": [
          ".ct"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ctilde",
        "scopeName": "source.ctilde",
        "path": "./syntaxes/ctilde.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ctilde",
        "scopes": {
          "namespace": ["entity.name.namespace.ctilde"],
          "namespace.defaultLibrary": ["support.type.namespace.ctilde"],
          "class": ["entity.name.type.class.ctilde"],
          "class.defaultLibrary": ["support.class.ctilde"],
          "struct": ["entity.name.type.struct.ctilde"],
          "enum": ["entity.name.type.enum.ctilde"],
          "enumMember": ["variable.other.enummember.ctilde"],
          "parameter": ["variable.parameter.ctilde"],
          "variable": ["variable.other.readwrite.ctilde"],
          "variable.readonly": ["variable.other.constant.ctilde"],
          "property": ["variable.other.property.ctilde"],
          "property.readonly": ["variable.other.constant.property.ctilde"],
          "property.defaultLibrary": ["support.variable.ctilde"],
          "method": ["entity.name.function.member.ctilde"],
          "method.defaultLibrary": ["support.function.ctilde"]
        }
      }
    ]
  }
}
