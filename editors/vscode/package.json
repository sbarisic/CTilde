{
  "name": "ctilde-language",
  "displayName": "C~ Language Support",
  "description": "C~ syntax and semantic highlighting, diagnostics, completion, and navigation.",
  "version": "0.8.0",
  "publisher": "ctilde",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbarisic/CTilde.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ctilde",
    "onUri:ctilde-stdlib",
    "onTaskType:ctilde",
    "onCommand:ctilde.project.check",
    "onCommand:ctilde.project.build",
    "onCommand:ctilde.project.generateBindings",
    "onCommand:ctilde.project.debug",
    "onCommand:ctilde.project.attach",
    "onDebug:ctilde"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "C~",
    "CTilde",
    "language",
    "syntax highlighting"
  ],
  "files": [
    "LICENSE",
    "language-configuration.json",
    "syntaxes/ctilde.tmLanguage.json",
    "schemas/ctilde.schema.json",
    "schemas/esp-idf-bindings.schema.json",
    "out/extension.js",
    "out/debugAdapter.js",
    "server/**",
    "compiler/**"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('server',{recursive:true,force:true});require('fs').rmSync('compiler',{recursive:true,force:true})\"",
    "compile": "tsc -p ./tsconfig.json --noEmit && esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=./out/extension.js && esbuild ./src/debugAdapter.ts --bundle --platform=node --format=cjs --outfile=./out/debugAdapter.js && esbuild ./src/debugModel.ts --bundle --platform=node --format=cjs --outfile=./out/debugModel.js && esbuild ./src/serverDevelopment.ts --bundle --platform=node --format=cjs --outfile=./out/serverDevelopment.js && esbuild ./src/projectBuild.ts --bundle --platform=node --format=cjs --outfile=./out/projectBuild.js && esbuild ./src/gdbMi.ts --bundle --platform=node --format=cjs --outfile=./out/gdbMi.js && esbuild ./src/test/runTest.ts --bundle --platform=node --format=cjs --packages=external --outfile=./out/test/runTest.js && esbuild ./src/test/suite/index.ts --bundle --platform=node --format=cjs --external:vscode --packages=external --outfile=./out/test/suite/index.js",
    "build:server": "dotnet publish ../../CTilde.LanguageServer/CTilde.LanguageServer.csproj -c Release --no-self-contained -o ./server",
    "build:compiler": "dotnet publish ../../CTilde.Cli/CTilde.Cli.csproj -c Release --no-self-contained -o ./compiler",
    "build": "npm run compile && npm run build:server && npm run build:compiler",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && npm run test:client && npm run test:metadata && npm run test:grammar && npm run test:sources && npm run build:server && npm run build:compiler && npm run test:server",
    "test:client": "node --test ./tests/server-development.test.mjs ./tests/project-build.test.mjs ./tests/gdb-mi.test.mjs ./tests/debug-model.test.mjs ../../Test/Esp32HardwareSupport.test.mjs",
    "test:metadata": "node --test ./tests/metadata.test.mjs",
    "test:grammar": "vscode-tmgrammar-test \"tests/**/*.test.ct\"",
    "test:sources": "node --test ./tests/source-tokenization.test.mjs",
    "test:server": "node --test ./tests/language-server.test.mjs",
    "test:extension": "npm run build && node ./out/test/runTest.js"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.3",
    "typescript": "5.8.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "ctilde.languageServer.restart",
        "title": "C~: Restart Language Server"
      },
      {
        "command": "ctilde.languageServer.showOutput",
        "title": "C~: Show Language Server Output"
      },
      {
        "command": "ctilde.project.check",
        "title": "C~: Check Project"
      },
      {
        "command": "ctilde.project.build",
        "title": "C~: Build Project"
      },
      {
        "command": "ctilde.project.generateBindings",
        "title": "C~: Generate ESP-IDF Bindings"
      },
      {
        "command": "ctilde.project.debug",
        "title": "C~: Debug Project"
      },
      {
        "command": "ctilde.project.attach",
        "title": "C~: Attach Debugger"
      }
    ],
    "configuration": {
      "title": "C~",
      "properties": {
        "ctilde.languageServer.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine",
          "description": "Path to the .NET 10 host used to run the C~ language server."
        },
        "ctilde.languageServer.serverPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Development override for the C~ language-server DLL. Accepts an absolute path, a workspace-relative path, or ${workspaceFolder}. Leave empty to use the server bundled with the extension."
        },
        "ctilde.languageServer.restartOnServerChange": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically restart an external development language server when its DLL or adjacent CTilde.Compiler.dll changes."
        },
        "ctilde.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication with the C~ language server."
        },
        "ctilde.compiler.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "C~ compiler executable or DLL. Accepts an absolute path, a workspace-relative path, or ${workspaceFolder}. Leave empty to use the compiler bundled with the extension."
        },
        "ctilde.compiler.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine",
          "description": "Path to the .NET 10 host used for a bundled or external C~ compiler DLL."
        },
        "ctilde.compiler.nativeCompiler": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional hosted C compiler override passed to project builds: auto, msvc, gcc, clang, or an executable path. Leave empty to use ctilde.json, CTILDE_CC, or platform discovery."
        },
        "ctilde.compiler.idfPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional ESP-IDF installation path used when idf.py is not already active. May be overridden by a workspace that targets a different ESP-IDF installation."
        },
        "ctilde.compiler.espClangPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional Espressif Clang executable used to inspect configured ESP-IDF headers while generating bindings. Generic host Clang is not accepted."
        },
        "ctilde.debugger.gdbPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional GDB executable override. Leave empty to use the debugger recorded by C~ debug preparation or toolchain discovery."
        },
        "ctilde.debugger.serialPort": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Serial port used for ESP-IDF runtime GDB-stub debugging, for example COM5 or /dev/ttyUSB0."
        },
        "ctilde.debugger.baudRate": {
          "type": "number",
          "default": 115200,
          "minimum": 1,
          "scope": "machine",
          "description": "UART baud rate used while handing an ESP-IDF target to GDB."
        },
        "ctilde.debugger.memoryDiagnostics": {
          "type": "string",
          "enum": ["off", "objects", "guarded"],
          "default": "objects",
          "scope": "machine",
          "description": "ARC diagnostics for newly prepared instrumented debug images. Objects tracks live allocations; guarded also adds canaries, poisoning, and bounded quarantine."
        },
        "ctilde.debugger.showRuntimeFrames": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show generated C~, ARC, and runtime frames plus raw logical-probe trap reports."
        }
      }
    },
    "breakpoints": [
      {
        "language": "ctilde"
      }
    ],
    "debuggers": [
      {
        "type": "ctilde",
        "label": "C~ GDB Debugger",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "ctilde"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "project"
            ],
            "properties": {
              "project": {
                "type": "string",
                "description": "Path to the C~ ctilde.json project."
              },
              "backend": {
                "type": "string",
                "enum": ["auto", "gdb"],
                "default": "auto"
              },
              "gdbPath": {
                "type": "string",
                "default": ""
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "showRuntimeFrames": {
                "type": "boolean",
                "default": false
              },
              "serialPort": {
                "type": "string",
                "default": ""
              },
              "baudRate": {
                "type": "number",
                "default": 115200,
                "minimum": 1
              },
              "memoryDiagnostics": {
                "type": "string",
                "enum": ["off", "objects", "guarded"],
                "default": "objects"
              }
            }
          },
          "attach": {
            "required": [
              "project"
            ],
            "properties": {
              "project": {
                "type": "string",
                "description": "Path to the C~ ctilde.json project."
              },
              "backend": {
                "type": "string",
                "enum": ["auto", "gdb"],
                "default": "auto"
              },
              "processId": {
                "type": ["string", "number"],
                "default": "${command:pickProcess}"
              },
              "gdbPath": {
                "type": "string",
                "default": ""
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "showRuntimeFrames": {
                "type": "boolean",
                "default": false
              },
              "serialPort": {
                "type": "string",
                "default": ""
              },
              "baudRate": {
                "type": "number",
                "default": 115200,
                "minimum": 1
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ctilde",
            "request": "launch",
            "name": "Debug C~ Project",
            "project": "${workspaceFolder}/ctilde.json",
            "backend": "auto",
            "gdbPath": "",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "showRuntimeFrames": false,
            "serialPort": "",
            "baudRate": 115200,
            "memoryDiagnostics": "objects"
          },
          {
            "type": "ctilde",
            "request": "attach",
            "name": "Attach C~ Debugger",
            "project": "${workspaceFolder}/ctilde.json",
            "backend": "auto",
            "processId": "${command:pickProcess}",
            "gdbPath": "",
            "cwd": "${workspaceFolder}",
            "showRuntimeFrames": false,
            "serialPort": "",
            "baudRate": 115200
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "ctilde",
        "required": [
          "project",
          "mode"
        ],
        "properties": {
          "project": {
            "type": "string",
            "description": "Path to ctilde.json."
          },
          "mode": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "bindings"
            ],
            "description": "Whether to check C~ semantics, produce native output, or generate tracked ESP-IDF bindings."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ctilde",
        "owner": "ctilde-build",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning|info)\\s+(CT\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/ctilde.json",
        "url": "./schemas/ctilde.schema.json"
      },
      {
        "fileMatch": "**/*.bindings.json",
        "url": "./schemas/esp-idf-bindings.schema.json"
      }
    ],
    "languages": [
      {
        "id": "ctilde",
        "aliases": [
          "C~",
          "CTilde"
        ],
        "extensions": [
          ".ct"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ctilde",
        "scopeName": "source.ctilde",
        "path": "./syntaxes/ctilde.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ctilde",
        "scopes": {
          "namespace": [
            "entity.name.namespace.ctilde"
          ],
          "namespace.defaultLibrary": [
            "support.type.namespace.ctilde"
          ],
          "class": [
            "entity.name.type.class.ctilde"
          ],
          "class.defaultLibrary": [
            "support.class.ctilde"
          ],
          "struct": [
            "entity.name.type.struct.ctilde"
          ],
          "enum": [
            "entity.name.type.enum.ctilde"
          ],
          "enumMember": [
            "variable.other.enummember.ctilde"
          ],
          "parameter": [
            "variable.parameter.ctilde"
          ],
          "variable": [
            "variable.other.readwrite.ctilde"
          ],
          "variable.readonly": [
            "variable.other.constant.ctilde"
          ],
          "property": [
            "variable.other.property.ctilde"
          ],
          "property.readonly": [
            "variable.other.constant.property.ctilde"
          ],
          "property.defaultLibrary": [
            "support.variable.ctilde"
          ],
          "method": [
            "entity.name.function.member.ctilde"
          ],
          "method.defaultLibrary": [
            "support.function.ctilde"
          ]
        }
      }
    ]
  }
}
