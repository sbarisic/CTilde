{
  "target": "esp-idf",
  "architecture": "xtensa",
  "sources": [
    "Protocol.ct",
    "SshNative.ct",
    "Transport.ct",
    "Configuration.ct",
    "Server.ct",
    "Sftp.ct"
  ],
  "espIdf": {
    "artifact": "managed-module"
  },
  "managedModule": {
    "kind": "library",
    "name": "system.ssh",
    "version": "1.0.0",
    "references": [],
    "nativeSources": [
      "main/ssh_native.c"
    ],
    "mainTaskStackBytes": 12288,
    "heapLimitBytes": 131072
  },
  "build": {
    "configuration": "release",
    "lto": true,
    "cLayout": "modules",
    "generatedDirectory": "main/generated",
    "generatedHeader": "main/generated/ctilde_exports.h",
    "espIdfProjectDirectory": ".",
    "optimization": "size",
    "floatingPoint": "precise"
  }
}
