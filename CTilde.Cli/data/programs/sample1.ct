using System;

namespace Examples;

public static class Wat
{
    public static void Print(string Str)
    {
        Console.WriteLine("You wrote: " + Str);
    }
}

public static class Program
{
    [EntryPoint]
    public static void Main()
    {
        int A = 2;
        int B = 3;
        int C = A + B;
        Wat.Print(C.ToString());
    }
}
