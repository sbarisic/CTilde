<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CTilde</RootNamespace>
    <AssemblyName>CTilde.Compiler</AssemblyName>
    <PackageId>CTilde.Compiler</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Compiler/**/*.cs" />
    <EmbeddedResource Include="StandardLibrary/**/*.ct" LogicalName="CTilde.StandardLibrary.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
