using System;
using System.Simd;

namespace HostedIoExample;

public struct Aabb
{
    public Vec3 Min;
    public Vec3 Max;

    public Aabb(Vec3 min, Vec3 max)
    {
        Min = min;
        Max = max;
    }

    [NoAlloc]
    public Vec3 Centroid()
    {
        return(Min + Max) * 0.5f;
    }

    [NoAlloc]
    public int LongestAxis()
    {
        Vec3 extent = Max - Min;
        if (extent.X >= extent.Y && extent.X >= extent.Z)
            return 0;
        if (extent.Y >= extent.Z)
            return 1;
        return 2;
    }

    [NoAlloc]
    public static Aabb Union(Aabb left, Aabb right)
    {
        return new Aabb(new Vec3(Math.Min(left.Min.X, right.Min.X), Math.Min(left.Min.Y,
            right.Min.Y), Math.Min(left.Min.Z, right.Min.Z)), new Vec3(Math.Max(left.Max.X,
            right.Max.X), Math.Max(left.Max.Y, right.Max.Y), Math.Max(left.Max.Z,
            right.Max.Z)));
    }

    [NoAlloc]
    public bool Hit(Ray ray, Interval interval)
    {
        float entry;
        return Hit(ray, interval, out entry);
    }

    [NoAlloc]
    public bool Hit(Ray ray, Interval interval, out float entry)
    {
        float near = interval.Min;
        float far = interval.Max;
        if (!IntersectAxis(ray.Origin.X, ray.Direction.X, Min.X, Max.X, ref near,
            ref far) || !IntersectAxis(ray.Origin.Y, ray.Direction.Y, Min.Y, Max.Y,
            ref near, ref far) || !IntersectAxis(ray.Origin.Z, ray.Direction.Z, Min.Z,
            Max.Z, ref near, ref far))
        {
            entry = interval.Max;
            return false;
        }
        entry = near;
        return true;
    }

    [NoAlloc]
    public Mask32x4 Hit4(RayPacket rays, Interval interval, Mask32x4 active)
    {
        F32x4 near = F32x4.Splat(interval.Min);
        F32x4 far = F32x4.Splat(interval.Max);
        Mask32x4 result = IntersectAxis4(rays.Origins.X, rays.Directions.X, Min.X,
            Max.X, ref near, ref far, active);
        result = IntersectAxis4(rays.Origins.Y, rays.Directions.Y, Min.Y, Max.Y,
            ref near, ref far, result);
        return IntersectAxis4(rays.Origins.Z, rays.Directions.Z, Min.Z, Max.Z, ref near,
            ref far, result);
    }

    [NoAlloc]
    private static Mask32x4 IntersectAxis4(F32x4 origin, F32x4 direction, float minimum,
        float maximum, ref F32x4 near, ref F32x4 far, Mask32x4 active)
    {
        Mask32x4 parallel = F32x4.CompareLessThan(F32x4.Abs(direction), F32x4.Splat(0.000000000001f));
        Mask32x4 inside = Mask32x4.And(F32x4.CompareGreaterThanOrEqual(origin, F32x4.Splat(minimum)),
            F32x4.CompareLessThanOrEqual(origin, F32x4.Splat(maximum)));
        F32x4 inverse = F32x4.Splat(1.0f) / direction;
        F32x4 first = (F32x4.Splat(minimum) - origin) * inverse;
        F32x4 second = (F32x4.Splat(maximum) - origin) * inverse;
        F32x4 axisNear = F32x4.Min(first, second);
        F32x4 axisFar = F32x4.Max(first, second);
        near = F32x4.Max(near, F32x4.Select(parallel, near, axisNear));
        far = F32x4.Min(far, F32x4.Select(parallel, far, axisFar));
        Mask32x4 parallelValid = Mask32x4.Or(Mask32x4.Not(parallel), inside);
        return Mask32x4.And(active, Mask32x4.And(parallelValid, F32x4.CompareGreaterThanOrEqual(far,
            near)));
    }

    [NoAlloc]
    private static bool IntersectAxis(float origin, float direction, float min, float max,
        ref float near, ref float far)
    {
        if (Math.Abs(direction) < 0.000000000001f)
            return origin >= min && origin <= max;
        float inverse = 1.0f / direction;
        float first = (min - origin) * inverse;
        float second = (max - origin) * inverse;
        if (first > second)
        {
            float swap = first;
            first = second;
            second = swap;
        }
        near = Math.Max(near, first);
        far = Math.Min(far, second);
        return far >= near;
    }
}

public struct HitRecord
{
    public Vec3 Point;
    public Vec3 Normal;
    public float Distance;
    public bool FrontFace;
    public Material SurfaceMaterial;

    [NoAlloc]
    public void SetFaceNormal(Ray ray, Vec3 outwardNormal)
    {
        FrontFace = ray.Direction.Dot(outwardNormal) < 0.0f;
        if (FrontFace)
            Normal = outwardNormal;
        else
            Normal = -outwardNormal;
    }
}

public struct HitPacket
{
    public HitRecord Lane0;
    public HitRecord Lane1;
    public HitRecord Lane2;
    public HitRecord Lane3;
    public Mask32x4 HitMask;
}

public class Hittable
{
    [NoAlloc]
    public virtual bool Hit(Ray ray, Interval interval, out HitRecord hit)
    {
        hit = new HitRecord();
        return false;
    }

    [NoAlloc]
    public virtual bool Hit4(RayPacket rays, Interval interval, Mask32x4 active,
        out HitPacket hits)
    {
        HitPacket result = new HitPacket();
        bool lane0 = active.GetLane<0>() && Hit(rays.GetLane<0>(), interval, out result.Lane0);
        bool lane1 = active.GetLane<1>() && Hit(rays.GetLane<1>(), interval, out result.Lane1);
        bool lane2 = active.GetLane<2>() && Hit(rays.GetLane<2>(), interval, out result.Lane2);
        bool lane3 = active.GetLane<3>() && Hit(rays.GetLane<3>(), interval, out result.Lane3);
        result.HitMask = PacketMasks.FromBools(lane0, lane1, lane2, lane3);
        hits = result;
        return result.HitMask.Any();
    }

    [NoAlloc]
    public virtual Aabb BoundingBox()
    {
        return new Aabb(Vec3.Zero, Vec3.Zero);
    }
}

public sealed class Sphere : Hittable
{
    private Vec3 center;
    private float radius;
    private Material material;

    public Sphere(Vec3 center, float radius, Material material)
    {
        this.center = center;
        this.radius = radius;
        this.material = material;
    }

    [NoAlloc]
    public override bool Hit(Ray ray, Interval interval, out HitRecord hit)
    {
        hit = new HitRecord();
        Vec3 centerToOrigin = ray.Origin - center;
        float a = ray.Direction.LengthSquared();
        float halfB = centerToOrigin.Dot(ray.Direction);
        float c = centerToOrigin.LengthSquared() - radius * radius;
        float discriminant = halfB * halfB - a * c;
        if (discriminant < 0.0f)
            return false;
        float root = (-halfB - Math.Sqrt(discriminant)) / a;
        if (!interval.Surrounds(root))
        {
            root = (-halfB + Math.Sqrt(discriminant)) / a;
            if (!interval.Surrounds(root))
                return false;
        }
        HitRecord result = new HitRecord();
        result.Distance = root;
        result.Point = ray.At(root);
        Vec3 outwardNormal = (result.Point - center) / radius;
        result.SetFaceNormal(ray, outwardNormal);
        result.SurfaceMaterial = material;
        hit = result;
        return true;
    }

    [NoAlloc]
    public override bool Hit4(RayPacket rays, Interval interval, Mask32x4 active,
        out HitPacket hits)
    {
        HitPacket result = new HitPacket();
        Vec3x4 centerToOrigin = rays.Origins - Vec3x4.Splat(center);
        F32x4 a = rays.Directions.LengthSquared();
        F32x4 halfB = centerToOrigin.Dot(rays.Directions);
        F32x4 c = centerToOrigin.LengthSquared() - F32x4.Splat(radius * radius);
        F32x4 discriminant = halfB * halfB - a * c;
        Mask32x4 hasRoot = Mask32x4.And(active, F32x4.CompareGreaterThanOrEqual(discriminant,
            F32x4.Zero));
        F32x4 squareRoot = F32x4.Sqrt(discriminant);
        F32x4 first = (-halfB - squareRoot) / a;
        F32x4 second = (-halfB + squareRoot) / a;
        Mask32x4 firstValid = Mask32x4.And(hasRoot, Mask32x4.And(F32x4.CompareGreaterThan(first,
            F32x4.Splat(interval.Min)), F32x4.CompareLessThan(first, F32x4.Splat(interval.Max))));
        Mask32x4 secondValid = Mask32x4.And(hasRoot, Mask32x4.And(F32x4.CompareGreaterThan(second,
            F32x4.Splat(interval.Min)), F32x4.CompareLessThan(second, F32x4.Splat(interval.Max))));
        result.HitMask = Mask32x4.Or(firstValid, secondValid);
        F32x4 distance = F32x4.Select(firstValid, first, second);
        Vec3x4 points = rays.At(distance);
        Vec3x4 outwardNormals = (points - Vec3x4.Splat(center)) / F32x4.Splat(radius);
        if (result.HitMask.GetLane<0>())
        {
            result.Lane0.Distance = distance.GetLane<0>();
            result.Lane0.Point = points.GetLane<0>();
            result.Lane0.SetFaceNormal(rays.GetLane<0>(), outwardNormals.GetLane<0>());
            result.Lane0.SurfaceMaterial = material;
        }
        if (result.HitMask.GetLane<1>())
        {
            result.Lane1.Distance = distance.GetLane<1>();
            result.Lane1.Point = points.GetLane<1>();
            result.Lane1.SetFaceNormal(rays.GetLane<1>(), outwardNormals.GetLane<1>());
            result.Lane1.SurfaceMaterial = material;
        }
        if (result.HitMask.GetLane<2>())
        {
            result.Lane2.Distance = distance.GetLane<2>();
            result.Lane2.Point = points.GetLane<2>();
            result.Lane2.SetFaceNormal(rays.GetLane<2>(), outwardNormals.GetLane<2>());
            result.Lane2.SurfaceMaterial = material;
        }
        if (result.HitMask.GetLane<3>())
        {
            result.Lane3.Distance = distance.GetLane<3>();
            result.Lane3.Point = points.GetLane<3>();
            result.Lane3.SetFaceNormal(rays.GetLane<3>(), outwardNormals.GetLane<3>());
            result.Lane3.SurfaceMaterial = material;
        }
        hits = result;
        return result.HitMask.Any();
    }

    [NoAlloc]
    public override Aabb BoundingBox()
    {
        float extent = Math.Abs(radius);
        Vec3 half = new Vec3(extent, extent, extent);
        return new Aabb(center - half, center + half);
    }
}

public sealed class HittableList : Hittable
{
    private Hittable[] objects;
    private int count;

    public HittableList()
    {
        objects = new Hittable[512];
        count = 0;
    }

    [NoAlloc]
    public int Count
    {
        get
        {
            return count;
        }
    }

    public void Add(Hittable value)
    {
        if (count >= objects.Length)
            throw new Exception("HittableList capacity exceeded.");
        objects[count] = value;
        count++;
    }

    public void Clear()
    {
        int index = 0;
        while (index < count)
        {
            objects[index] = null;
            index++;
        }
        count = 0;
    }

    public Hittable BuildBvh()
    {
        if (count == 0)
            return this;
        return BvhNode.Build(objects, 0, count);
    }

    [NoAlloc]
    public override bool Hit(Ray ray, Interval interval, out HitRecord hit)
    {
        HitRecord closestHit = new HitRecord();
        bool hitAnything = false;
        float closestDistance = interval.Max;
        int index = 0;
        while (index < count)
        {
            HitRecord candidate;
            bool didHit = objects[index].Hit(ray, new Interval(interval.Min, closestDistance),
                out candidate);
            if (didHit)
            {
                hitAnything = true;
                closestDistance = candidate.Distance;
                closestHit = candidate;
            }
            index++;
        }
        hit = closestHit;
        return hitAnything;
    }

    [NoAlloc]
    public override bool Hit4(RayPacket rays, Interval interval, Mask32x4 active,
        out HitPacket hits)
    {
        HitPacket result = new HitPacket();
        bool lane0 = active.GetLane<0>() && Hit(rays.GetLane<0>(), interval, out result.Lane0);
        bool lane1 = active.GetLane<1>() && Hit(rays.GetLane<1>(), interval, out result.Lane1);
        bool lane2 = active.GetLane<2>() && Hit(rays.GetLane<2>(), interval, out result.Lane2);
        bool lane3 = active.GetLane<3>() && Hit(rays.GetLane<3>(), interval, out result.Lane3);
        result.HitMask = PacketMasks.FromBools(lane0, lane1, lane2, lane3);
        hits = result;
        return result.HitMask.Any();
    }

    [NoAlloc]
    public override Aabb BoundingBox()
    {
        if (count == 0)
            return new Aabb(Vec3.Zero, Vec3.Zero);
        Aabb bounds = objects[0].BoundingBox();
        int index = 1;
        while (index < count)
        {
            bounds = Aabb.Union(bounds, objects[index].BoundingBox());
            index++;
        }
        return bounds;
    }
}

public sealed class BvhNode : Hittable
{
    private Hittable left;
    private Hittable right;
    private bool hasRight;
    private Aabb leftBounds;
    private Aabb rightBounds;
    private Aabb bounds;

    private BvhNode(Hittable left, Hittable right, bool hasRight)
    {
        this.left = left;
        this.right = right;
        this.hasRight = hasRight;
        leftBounds = left.BoundingBox();
        if (hasRight)
        {
            rightBounds = right.BoundingBox();
            bounds = Aabb.Union(leftBounds, rightBounds);
        }
        else
        {
            rightBounds = leftBounds;
            bounds = leftBounds;
        }
    }

    public static Hittable Build(Hittable[] objects, int start, int end)
    {
        int length = end - start;
        if (length == 1)
            return new BvhNode(objects[start], null, false);
        Aabb aggregate = objects[start].BoundingBox();
        int index = start + 1;
        while (index < end)
        {
            aggregate = Aabb.Union(aggregate, objects[index].BoundingBox());
            index++;
        }
        int axis = aggregate.LongestAxis();
        StableSort(objects, start, end, axis);
        int midpoint = start + length / 2;
        Hittable left;
        Hittable right;
        if (length == 2)
        {
            left = objects[start];
            right = objects[start + 1];
        }
        else
        {
            left = Build(objects, start, midpoint);
            right = Build(objects, midpoint, end);
        }
        return new BvhNode(left, right, true);
    }

    private static void StableSort(Hittable[] objects, int start, int end, int axis)
    {
        int index = start + 1;
        while (index < end)
        {
            Hittable value = objects[index];
            float centroid = Axis(value.BoundingBox().Centroid(), axis);
            int insertion = index;
            while (insertion > start && Axis(objects[insertion - 1].BoundingBox().Centroid(),
                axis) > centroid)
            {
                objects[insertion] = objects[insertion - 1];
                insertion--;
            }
            objects[insertion] = value;
            index++;
        }
    }

    [NoAlloc]
    private static float Axis(Vec3 value, int axis)
    {
        if (axis == 0)
            return value.X;
        if (axis == 1)
            return value.Y;
        return value.Z;
    }

    [NoAlloc]
    public override Aabb BoundingBox()
    {
        return bounds;
    }

    [NoAlloc]
    public override bool Hit(Ray ray, Interval interval, out HitRecord hit)
    {
        hit = new HitRecord();
        if (!bounds.Hit(ray, interval))
            return false;
        float leftEntry;
        bool canHitLeft = leftBounds.Hit(ray, interval, out leftEntry);
        float rightEntry = interval.Max;
        bool canHitRight = hasRight && rightBounds.Hit(ray, interval, out rightEntry);
        if (!canHitLeft && !canHitRight)
            return false;
        Hittable first = left;
        Hittable second = right;
        bool canHitFirst = canHitLeft;
        bool canHitSecond = canHitRight;
        if (canHitRight && (!canHitLeft || rightEntry < leftEntry))
        {
            first = right;
            second = left;
            canHitFirst = canHitRight;
            canHitSecond = canHitLeft;
        }
        bool hitAnything = false;
        float closest = interval.Max;
        HitRecord candidate;
        if (canHitFirst && first.Hit(ray, interval, out candidate))
        {
            hitAnything = true;
            closest = candidate.Distance;
            hit = candidate;
        }
        if (canHitSecond && second.Hit(ray, new Interval(interval.Min, closest),
            out candidate))
        {
            hitAnything = true;
            hit = candidate;
        }
        return hitAnything;
    }

    [NoAlloc]
    public override bool Hit4(RayPacket rays, Interval interval, Mask32x4 active,
        out HitPacket hits)
    {
        Mask32x4 bounded = bounds.Hit4(rays, interval, active);
        if (!hasRight)
        {
            HitPacket leafHits;
            bool leafResult = left.Hit4(rays, interval, bounded, out leafHits);
            hits = leafHits;
            return leafResult;
        }
        HitPacket result = new HitPacket();
        bool lane0 = bounded.GetLane<0>() && Hit(rays.GetLane<0>(), interval, out result.Lane0);
        bool lane1 = bounded.GetLane<1>() && Hit(rays.GetLane<1>(), interval, out result.Lane1);
        bool lane2 = bounded.GetLane<2>() && Hit(rays.GetLane<2>(), interval, out result.Lane2);
        bool lane3 = bounded.GetLane<3>() && Hit(rays.GetLane<3>(), interval, out result.Lane3);
        result.HitMask = PacketMasks.FromBools(lane0, lane1, lane2, lane3);
        hits = result;
        return result.HitMask.Any();
    }
}
