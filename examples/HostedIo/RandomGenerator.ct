using System;
using System.Simd;

namespace HostedIoExample;

public sealed class RandomGenerator
{
    public const uint DefaultSeed = 0x00C0FFEEu;
    public const uint DefaultSceneSeed = 0x00C0FFEEu;
    public const uint DefaultRenderSeed = 0x5EED1234u;
    private uint state;

    public RandomGenerator(uint seed)
    {
        Reseed(seed);
    }

    [NoAlloc]
    public void Reseed(uint seed)
    {
        if (seed == 0u)
            state = DefaultSeed;
        else
            state = seed;
    }

    // This 32-bit avalanche mix derives an independent stream for each pixel sample.
    [NoAlloc]
    public static uint SampleSeed(uint globalSeed, int column, int row, int sample)
    {
        uint value = globalSeed;
        value = value ^ ((uint)column * 0x9E3779B9u);
        value = value ^ ((uint)row * 0x85EBCA6Bu);
        value = value ^ ((uint)sample * 0xC2B2AE35u);
        value = value ^ (value >> 16);
        value = value * 0x7FEB352Du;
        value = value ^ (value >> 15);
        value = value * 0x846CA68Bu;
        value = value ^ (value >> 16);
        if (value == 0u)
            return DefaultSeed;
        return value;
    }

    [NoAlloc]
    public uint NextUInt()
    {
        uint value = state;
        value = value ^ (value << 13);
        value = value ^ (value >> 17);
        value = value ^ (value << 5);
        state = value;
        return value;
    }

    [NoAlloc]
    public float NextFloat()
    {
        return(float)(NextUInt() >> 8) / 16777216.0f;
    }

    [NoAlloc]
    public float Range(float min, float max)
    {
        return min + (max - min) * NextFloat();
    }

    [NoAlloc]
    public Vec3 Vector()
    {
        return new Vec3(NextFloat(), NextFloat(), NextFloat());
    }

    [NoAlloc]
    public Vec3 Vector(float min, float max)
    {
        return new Vec3(Range(min, max), Range(min, max), Range(min, max));
    }

    [NoAlloc]
    public Vec3 InUnitSphere()
    {
        while (true)
        {
            Vec3 point = Vector(-1.0f, 1.0f);
            float lengthSquared = point.LengthSquared();
            if (lengthSquared < 1.0f && lengthSquared > 0.000000000001f)
                return point;
        }
        return Vec3.Zero;
    }

    [NoAlloc]
    public Vec3 UnitVector()
    {
        return InUnitSphere().Normalize();
    }

    [NoAlloc]
    public Vec3 InUnitDisk()
    {
        while (true)
        {
            Vec3 point = new Vec3(Range(-1.0f, 1.0f), Range(-1.0f, 1.0f), 0.0f);
            if (point.LengthSquared() < 1.0f)
                return point;
        }
        return Vec3.Zero;
    }
}

public sealed class PacketRandomGenerator
{
    private U32x4 state;

    public PacketRandomGenerator(uint seed)
    {
        state = U32x4.Splat(seed);
    }

    [NoAlloc]
    public static U32x4 SampleSeeds(uint globalSeed, int firstColumn, int row, int sample,
        Mask32x4 active)
    {
        U32x4 value = U32x4.Splat(globalSeed);
        U32x4 columns = U32x4.Create((uint)firstColumn, (uint)(firstColumn + 1),
            (uint)(firstColumn + 2), (uint)(firstColumn + 3));
        value = U32x4.Xor(value, columns * U32x4.Splat(0x9E3779B9u));
        value = U32x4.Xor(value, U32x4.Splat((uint)row) * U32x4.Splat(0x85EBCA6Bu));
        value = U32x4.Xor(value, U32x4.Splat((uint)sample) * U32x4.Splat(0xC2B2AE35u));
        value = U32x4.Xor(value, value.ShiftRight<16>());
        value = value * U32x4.Splat(0x7FEB352Du);
        value = U32x4.Xor(value, value.ShiftRight<15>());
        value = value * U32x4.Splat(0x846CA68Bu);
        value = U32x4.Xor(value, value.ShiftRight<16>());
        Mask32x4 zero = U32x4.CompareEqual(value, U32x4.Zero);
        value = U32x4.Select(zero, U32x4.Splat(RandomGenerator.DefaultSeed), value);
        return U32x4.Select(active, value, U32x4.Splat(RandomGenerator.DefaultSeed));
    }

    [NoAlloc]
    public void Reseed(U32x4 seeds)
    {
        state = seeds;
    }

    [NoAlloc]
    public U32x4 NextUInt(Mask32x4 active)
    {
        U32x4 value = state;
        value = U32x4.Xor(value, value.ShiftLeft<13>());
        value = U32x4.Xor(value, value.ShiftRight<17>());
        value = U32x4.Xor(value, value.ShiftLeft<5>());
        state = U32x4.Select(active, value, state);
        return U32x4.Select(active, value, U32x4.Zero);
    }

    [NoAlloc]
    public F32x4 NextFloat(Mask32x4 active)
    {
        return F32x4.Select(active, F32x4.FromU32(NextUInt(active).ShiftRight<8>())
            / F32x4.Splat(16777216.0f), F32x4.Zero);
    }

    [NoAlloc]
    public F32x4 Range(float minimum, float maximum, Mask32x4 active)
    {
        return F32x4.Splat(minimum) + F32x4.Splat(maximum - minimum) * NextFloat(active);
    }

    [NoAlloc]
    public Vec3x4 Vector(float minimum, float maximum, Mask32x4 active)
    {
        return new Vec3x4(Range(minimum, maximum, active), Range(minimum, maximum,
            active), Range(minimum, maximum, active));
    }

    [NoAlloc]
    public Vec3x4 InUnitSphere(Mask32x4 active)
    {
        Vec3x4 result = Vec3x4.Zero;
        Mask32x4 pending = active;
        while (pending.Any())
        {
            Vec3x4 candidate = Vector(-1.0f, 1.0f, pending);
            F32x4 lengthSquared = candidate.LengthSquared();
            Mask32x4 accepted = Mask32x4.And(pending, Mask32x4.And(F32x4.CompareLessThan(lengthSquared,
                F32x4.Splat(1.0f)), F32x4.CompareGreaterThan(lengthSquared, F32x4.Splat(0.000000000001f))));
            result = Vec3x4.Select(accepted, candidate, result);
            pending = Mask32x4.AndNot(accepted, pending);
        }
        return result;
    }

    [NoAlloc]
    public Vec3x4 UnitVector(Mask32x4 active)
    {
        return Vec3x4.Select(active, InUnitSphere(active).Normalize(), Vec3x4.Zero);
    }

    [NoAlloc]
    public Vec3x4 InUnitDisk(Mask32x4 active)
    {
        Vec3x4 result = Vec3x4.Zero;
        Mask32x4 pending = active;
        while (pending.Any())
        {
            Vec3x4 candidate = new Vec3x4(Range(-1.0f, 1.0f, pending), Range(-1.0f,
                1.0f, pending), F32x4.Zero);
            Mask32x4 accepted = Mask32x4.And(pending, F32x4.CompareLessThan(candidate.LengthSquared(),
                F32x4.Splat(1.0f)));
            result = Vec3x4.Select(accepted, candidate, result);
            pending = Mask32x4.AndNot(accepted, pending);
        }
        return result;
    }
}
