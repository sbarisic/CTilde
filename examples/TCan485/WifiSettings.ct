namespace Examples.TCan485;

public static class WifiSettings
{
    // Configure these values locally. An empty SSID selects the offline fallback.
    public const string Ssid = "";
    public const string Password = "";
    public const string Url = "https://example.com/";
    public const uint ConnectionTimeoutMilliseconds = 15000u;
    public const int HttpTimeoutMilliseconds = 10000;
    public const uint MaximumResponseBytes = 65536u;
    public const int PreviewBytes = 256;
}
