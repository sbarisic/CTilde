menu "C~ managed runtime"

config CTILDE_MANAGED_MEMORY_TRACE
    bool "Emit JSON memory samples at managed lifecycle boundaries"
    default n
    help
        Emit versioned CT_MEMORY JSON records to the firmware log. Samples are
        global heap observations, not per-process attribution or continuous
        peak measurements. Logging can affect timing. Use the same setting
        for baseline and comparison firmware.

config CTILDE_MANAGED_TLS_INDEX
    int "FreeRTOS TLS index"
    range 0 7
    default 2
    help
        TLS slot reserved for the C~ process and module execution context.

config CTILDE_MANAGED_MAX_MODULES
    int "Maximum loaded managed modules"
    range 4 64
    default 16

config CTILDE_MANAGED_MAX_PROCESSES
    int "Maximum concurrent managed process slots"
    range 16 256
    default 16

config CTILDE_MANAGED_MAX_CALL_DEPTH
    int "Maximum nested managed cross-module calls"
    range 16 256
    default 64
    help
        Maximum number of provider-owned managed call frames retained by one
        execution context. This is independent from the loaded-module limit.

endmenu
