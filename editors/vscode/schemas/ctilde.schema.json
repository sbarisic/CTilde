{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C~ project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "target": {
      "type": "string",
      "enum": [
        "hosted",
        "esp-idf",
        "freestanding"
      ],
      "default": "hosted",
      "description": "Compiler target and target-specific standard library."
    },
    "architecture": {
      "type": "string",
      "enum": ["auto", "x86", "x64", "arm32", "arm64", "xtensa", "riscv32", "riscv64"],
      "default": "auto",
      "description": "Compilation architecture used by compile-time target queries and target-specific intrinsics."
    },
    "noRecursion": {
      "type": "boolean",
      "default": false,
      "description": "Reject recursion and calls whose possible targets cannot be closed statically in every reachable method."
    },
    "panicPolicy": {
      "type": "string",
      "enum": ["abort", "restart", "halt"],
      "default": "abort",
      "description": "ESP-IDF fatal-panic terminal policy. The halt policy requires CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Source globs relative to this manifest."
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Source globs removed after the sources patterns are evaluated."
    },
    "espIdf": {
      "type": "object",
      "additionalProperties": false,
      "description": "ESP-IDF-specific project inputs.",
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Project-relative ESP-IDF binding manifest paths."
        }
      }
    },
    "freestanding": {
      "type": "object",
      "additionalProperties": false,
      "description": "GNU/ELF freestanding linker and native inputs.",
      "properties": {
        "linkerScript": { "type": "string", "minLength": 1 },
        "entrySymbol": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "nativeSources": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.(c|s|S)$" }
        },
        "objectFiles": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.o$" }
        },
        "libraries": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.a$" }
        },
        "compileOptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "linkOptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional generated-output and native-build settings.",
      "properties": {
        "generatedC": {
          "type": "string",
          "minLength": 1,
          "description": "Generated C path relative to the project directory."
        },
        "generatedHeader": {
          "type": "string",
          "minLength": 1,
          "description": "Generated native header path relative to the project directory."
        },
        "cLayout": {
          "type": "string",
          "enum": ["unity", "modules"],
          "default": "unity",
          "description": "Generated C layout. Modular output partitions reachable definitions by stable source identity after whole-program optimization."
        },
        "generatedDirectory": {
          "type": "string",
          "minLength": 1,
          "description": "Generated modular bundle directory relative to the project directory."
        },
        "symbolMap": {
          "type": "string",
          "minLength": 1,
          "description": "Optional generated JSON symbol-map path relative to the project directory."
        },
        "lto": {
          "type": "boolean",
          "default": false,
          "description": "Enable hosted link-time optimization. Requires Release configuration."
        },
        "configuration": {
          "type": "string",
          "enum": ["debug", "release"],
          "default": "debug",
          "description": "Hosted native build configuration."
        },
        "compiler": {
          "type": "string",
          "minLength": 1,
          "default": "auto",
          "description": "Hosted C compiler name or path."
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "Hosted executable path relative to the project directory."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Freestanding ELF image path relative to the project directory."
        },
        "espIdfProjectDirectory": {
          "type": "string",
          "minLength": 1,
          "default": ".",
          "description": "ESP-IDF project directory relative to the C~ project directory."
        }
      }
    }
  }
}
