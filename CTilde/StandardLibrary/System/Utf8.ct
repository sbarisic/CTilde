using System.Runtime;

namespace System.Text;

public static class Utf8
{
    public static unsafe string GetString(
        [Nullable]
        byte* value, nuint maxBytes)
    {
        return Utf8Runtime.GetStringPointer(value, maxBytes);
    }

    public static unsafe bool TryGetString(
        [Nullable]
        byte* value, nuint maxBytes, out string result)
    {
        bool success;
        result = Utf8Runtime.TryGetStringPointer(value, maxBytes, out success);
        return success;
    }

    public static unsafe string GetString(ReadOnlyNativeBuffer<byte> value)
    {
        return Utf8Runtime.GetStringBuffer(value);
    }

    public static unsafe bool TryGetString(ReadOnlyNativeBuffer<byte> value, out string result)
    {
        bool success;
        result = Utf8Runtime.TryGetStringBuffer(value, out success);
        return success;
    }

    public static nuint GetByteCount(string value)
    {
        if (value == null)
            System.StringRuntime.ArgumentNull();
        return(nuint)value.Length;
    }

    public static unsafe bool TryCopyTo(string value, NativeBuffer<byte> destination,
        bool nullTerminate, out nuint bytesWritten)
    {
        bytesWritten = 0;
        if (value == null)
            System.StringRuntime.ArgumentNull();
        return Utf8Runtime.TryCopyTo(value, destination, nullTerminate, out bytesWritten);
    }

    [NoAlloc]
    public static bool TryDecode(string source, int offset, out rune value, out int bytesRead)
    {
        value = r'\0';
        bytesRead = 0;
        if (source == null || offset < 0 || offset >= source.Length)
        {
            return false;
        }
        uint first = (uint)source[offset];
        int length = SequenceLength(first);
        if (length == 0 || offset + length > source.Length)
        {
            return false;
        }
        uint scalar = InitialScalar(first, length);
        for (int index = 1; index < length; index++)
        {
            uint next = (uint)source[offset + index];
            if (!IsContinuation(next))
            {
                return false;
            }
            scalar = (scalar << 6) | (next & 63u);
        }
        if (!IsValidScalar(scalar, length))
        {
            return false;
        }
        value = (rune)scalar;
        bytesRead = length;
        return true;
    }

    [NoAlloc]
    public static unsafe bool TryDecode(ReadOnlyNativeBuffer<byte> source, out rune value,
        out nuint bytesRead)
    {
        value = r'\0';
        bytesRead = 0;
        if (source.Length == 0)
        {
            return false;
        }
        uint first = (uint)source[0];
        int length = SequenceLength(first);
        if (length == 0 || source.Length < (nuint)length)
        {
            return false;
        }
        uint scalar = InitialScalar(first, length);
        for (int index = 1; index < length; index++)
        {
            uint next = (uint)source[(nuint)index];
            if (!IsContinuation(next))
            {
                return false;
            }
            scalar = (scalar << 6) | (next & 63u);
        }
        if (!IsValidScalar(scalar, length))
        {
            return false;
        }
        value = (rune)scalar;
        bytesRead = (nuint)length;
        return true;
    }

    [NoAlloc]
    public static unsafe bool TryEncode(rune value, NativeBuffer<byte> destination,
        out nuint bytesWritten)
    {
        bytesWritten = 0;
        uint scalar = (uint)value;
        nuint required = 1;
        if (scalar > 127u)
        {
            if (scalar <= 2047u)
            {
                required = 2;
            }
            else if (scalar <= 65535u)
            {
                required = 3;
            }
            else
            {
                required = 4;
            }
        }
        if (destination.Length < required)
        {
            return false;
        }
        if (required == 1)
        {
            destination[0] = (byte)scalar;
        }
        else if (required == 2)
        {
            destination[0] = (byte)(192u | (scalar >> 6));
            destination[1] = (byte)(128u | (scalar & 63u));
        }
        else if (required == 3)
        {
            destination[0] = (byte)(224u | (scalar >> 12));
            destination[1] = (byte)(128u | ((scalar >> 6) & 63u));
            destination[2] = (byte)(128u | (scalar & 63u));
        }
        else
        {
            destination[0] = (byte)(240u | (scalar >> 18));
            destination[1] = (byte)(128u | ((scalar >> 12) & 63u));
            destination[2] = (byte)(128u | ((scalar >> 6) & 63u));
            destination[3] = (byte)(128u | (scalar & 63u));
        }
        bytesWritten = required;
        return true;
    }

    [NoAlloc]
    private static int SequenceLength(uint first)
    {
        if (first <= 127u)
        {
            return 1;
        }
        if (first >= 194u && first <= 223u)
        {
            return 2;
        }
        if (first >= 224u && first <= 239u)
        {
            return 3;
        }
        if (first >= 240u && first <= 244u)
        {
            return 4;
        }
        return 0;
    }

    [NoAlloc]
    private static uint InitialScalar(uint first, int length)
    {
        if (length == 1)
        {
            return first;
        }
        if (length == 2)
        {
            return first & 31u;
        }
        if (length == 3)
        {
            return first & 15u;
        }
        return first & 7u;
    }

    [NoAlloc]
    private static bool IsContinuation(uint value)
    {
        return value >= 128u && value <= 191u;
    }

    [NoAlloc]
    private static bool IsValidScalar(uint scalar, int length)
    {
        if (length == 2 && scalar < 128u)
        {
            return false;
        }
        if (length == 3 && scalar < 2048u)
        {
            return false;
        }
        if (length == 4 && scalar < 65536u)
        {
            return false;
        }
        if (scalar >= 55296u && scalar <= 57343u)
        {
            return false;
        }
        return scalar <= 1114111u;
    }
}

public static class Ascii
{
    [NoAlloc]
    public static bool IsWhiteSpace(char value)
    {
        return value == ' ' || value == '\t' || value == '\n' || value == '\r' || value
            == '\f' || value == '\v';
    }

    [NoAlloc]
    public static bool IsLetter(char value)
    {
        return value >= 'A' && value <= 'Z' || value >= 'a' && value <= 'z';
    }

    [NoAlloc]
    public static bool IsDigit(char value)
    {
        return value >= '0' && value <= '9';
    }

    [NoAlloc]
    public static char ToLower(char value)
    {
        if (value >= 'A' && value <= 'Z')
            return(char)(value + ('a' - 'A'));
        return value;
    }

    [NoAlloc]
    public static char ToUpper(char value)
    {
        if (value >= 'a' && value <= 'z')
            return(char)(value - ('a' - 'A'));
        return value;
    }

    [NoAlloc]
    public static int CompareIgnoreCase(string left, string right)
    {
        if (left == right)
            return 0;
        if (left == null)
            return -1;
        if (right == null)
            return 1;
        int count = left.Length;
        if (right.Length < count)
            count = right.Length;
        for (int index = 0; index < count; index++)
        {
            char a = ToLower(left[index]);
            char b = ToLower(right[index]);
            if (a < b)
                return -1;
            if (a > b)
                return 1;
        }
        if (left.Length < right.Length)
            return -1;
        if (left.Length > right.Length)
            return 1;
        return 0;
    }

    [NoAlloc]
    public static bool EqualsIgnoreCase(string left, string right)
    {
        return CompareIgnoreCase(left, right) == 0;
    }
}

internal static class Utf8Runtime
{
    [Extern("ct_utf8_get_string_pointer")]
    internal static unsafe string GetStringPointer(
        [Nullable]
        byte* value, nuint maxBytes);

    [Extern("ct_utf8_try_get_string_pointer")]
    internal static unsafe string TryGetStringPointer(
        [Nullable]
        byte* value, nuint maxBytes, out bool success);

    [Extern("ct_utf8_get_string_buffer")]
    internal static unsafe string GetStringBuffer(ReadOnlyNativeBuffer<byte> value);

    [Extern("ct_utf8_try_get_string_buffer")]
    internal static unsafe string TryGetStringBuffer(ReadOnlyNativeBuffer<byte> value,
        out bool success);

    [Extern("ct_utf8_try_copy_to")]
    [NoAlloc]
    internal static unsafe bool TryCopyTo(string value, NativeBuffer<byte> destination,
        bool nullTerminate, out nuint bytesWritten);
}
