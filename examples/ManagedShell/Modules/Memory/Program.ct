using System;

internal static class DiagnosticsPlatform
{
    [Extern("ct_managed_diagnostics_print_memory")]
    [NoAlloc]
    [NoThrow]
    internal static void PrintMemory();
}

public static class Program
{
    [EntryPoint]
    public static int Main(string[] args)
    {
        if (args.Length != 0)
        {
            Console.WriteLine("usage: memory");
            return 2;
        }
        DiagnosticsPlatform.PrintMemory();
        return 0;
    }
}
