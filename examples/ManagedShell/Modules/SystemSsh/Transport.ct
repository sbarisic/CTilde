using System;
using System.Text;

namespace System.Ssh;

internal sealed class SshPacketReader
{
    private byte[] data;
    private int position;

    internal SshPacketReader(byte[] data)
    {
        this.data = data;
        position = 0;
    }

    internal int Remaining
    {
        get
        {
            return data.Length - position;
        }
    }

    internal int Position
    {
        get
        {
            return position;
        }
    }

    internal byte ReadByte()
    {
        Require(1);
        return data[position++];
    }

    internal bool ReadBoolean()
    {
        return ReadByte() != 0;
    }

    internal uint ReadUInt32()
    {
        Require(4);
        uint value = SshWire.ReadUInt32(data, position);
        position += 4;
        return value;
    }

    internal ulong ReadUInt64()
    {
        ulong high = (ulong)ReadUInt32();
        ulong low = (ulong)ReadUInt32();
        return high << 32 | low;
    }

    internal byte[] ReadBytes()
    {
        uint length = ReadUInt32();
        if (length > 35000u || length > (uint)Remaining)
            throw new InvalidOperationException();
        byte[] result = new byte[(int)length];
        for (int index = 0; index < result.Length; index++)
            result[index] = data[position + index];
        position += result.Length;
        return result;
    }

    internal byte[] ReadFixed(int count)
    {
        Require(count);
        byte[] result = new byte[count];
        for (int index = 0; index < count; index++)
            result[index] = data[position + index];
        position += count;
        return result;
    }

    internal string ReadString()
    {
        byte[] value = ReadBytes();
        return Encoding.UTF8.GetString(value);
    }

    internal byte[] Prefix(int count)
    {
        if (count < 0 || count > data.Length)
            throw new ArgumentOutOfRangeException();
        byte[] result = new byte[count];
        for (int index = 0; index < count; index++)
            result[index] = data[index];
        return result;
    }

    internal void RequireEnd()
    {
        if (position != data.Length)
            throw new InvalidOperationException();
    }

    private void Require(int count)
    {
        if (count < 0 || position > data.Length - count)
            throw new InvalidOperationException();
    }
}

internal sealed class SshPacketWriter
{
    private byte[] data;
    private int position;

    internal SshPacketWriter(int capacity)
    {
        data = new byte[capacity];
        position = 0;
    }

    internal int Length
    {
        get
        {
            return position;
        }
    }

    internal void WriteByte(byte value)
    {
        Require(1);
        data[position++] = value;
    }

    internal void WriteBoolean(bool value)
    {
        if (value)
            WriteByte((byte)1);
        else
            WriteByte((byte)0);
    }

    internal void WriteUInt32(uint value)
    {
        Require(4);
        SshWire.WriteUInt32(data, position, value);
        position += 4;
    }

    internal void WriteUInt64(ulong value)
    {
        WriteUInt32((uint)(value >> 32));
        WriteUInt32((uint)value);
    }

    internal void WriteRaw(byte[] value)
    {
        Require(value.Length);
        for (int index = 0; index < value.Length; index++)
            data[position++] = value[index];
    }

    internal void WriteBytes(byte[] value)
    {
        WriteUInt32((uint)value.Length);
        WriteRaw(value);
    }

    internal void WriteString(string value)
    {
        WriteBytes(Encoding.UTF8.GetBytes(value));
    }

    internal byte[] ToArray()
    {
        byte[] result = new byte[position];
        for (int index = 0; index < position; index++)
            result[index] = data[index];
        return result;
    }

    private void Require(int count)
    {
        if (count < 0 || position > data.Length - count)
            throw new InvalidOperationException();
    }
}

[Overlay("transport")]
internal sealed class SshTransport
{
    private uint socket;
    private int maximumPacket;
    private bool encrypted;
    private uint inboundCipher;
    private uint outboundCipher;
    private byte[] inboundIv;
    private byte[] outboundIv;
    private uint inboundSequence;
    private uint outboundSequence;
    private ulong inboundInvocation;
    private ulong outboundInvocation;
    private long bytesReceived;
    private long bytesSent;
    private string clientVersion;
    private string serverVersion;

    internal SshTransport(uint socket, int maximumPacket)
    {
        this.socket = socket;
        this.maximumPacket = maximumPacket;
        inboundIv = new byte[12];
        outboundIv = new byte[12];
        serverVersion = "SSH-2.0-CTilde_0.49";
    }

    internal string ClientVersion
    {
        get
        {
            return clientVersion;
        }
    }

    internal string ServerVersion
    {
        get
        {
            return serverVersion;
        }
    }

    internal long BytesReceived
    {
        get
        {
            return bytesReceived;
        }
    }

    internal long BytesSent
    {
        get
        {
            return bytesSent;
        }
    }

    internal uint Socket
    {
        get
        {
            return socket;
        }
    }

    internal void ExchangeIdentification(long deadline)
    {
        byte[] banner = Encoding.UTF8.GetBytes(serverVersion + "\r\n");
        SendExact(banner, 0, banner.Length, 5000u);
        byte[] received = new byte[1024];
        int used = 0;
        int lineStart = 0;
        while (used < received.Length)
        {
            long left = deadline - SshNative.MonotonicMilliseconds();
            if (left <= 0L)
                throw new InvalidOperationException();
            uint timeout = (uint)left;
            if (timeout > 5000u)
                timeout = 5000u;
            int count = SshNative.Receive(socket, received, used, 1, timeout);
            if (count <= 0)
                throw new InvalidOperationException();
            bytesReceived += count;
            if (received[used] == (byte)'\n')
            {
                int lineLength = used - lineStart;
                if (lineLength > 0 && received[used - 1] == (byte)'\r')
                    lineLength--;
                if (lineLength > 255)
                    throw new InvalidOperationException();
                string line = Encoding.UTF8.GetString(received, lineStart, lineLength);
                if (line.StartsWith("SSH-2.0-"))
                {
                    clientVersion = line;
                    return;
                }
                lineStart = used + 1;
            }
            used++;
        }
        throw new InvalidOperationException();
    }

    internal void Activate(byte[] receiveKey, byte[] receiveIvValue, byte[] sendKey,
        byte[] sendIvValue)
    {
        uint replacementInbound;
        uint replacementOutbound;
        SshNative.Require(SshNative.AesCreate(receiveKey, out replacementInbound));
        try
        {
            SshNative.Require(SshNative.AesCreate(sendKey, out replacementOutbound));
        }
        catch (Exception)
        {
            SshNative.Close(replacementInbound);
            throw;
        }
        if (inboundCipher != 0u)
            SshNative.Close(inboundCipher);
        if (outboundCipher != 0u)
            SshNative.Close(outboundCipher);
        inboundCipher = replacementInbound;
        outboundCipher = replacementOutbound;
        for (int index = 0; index < 12; index++)
        {
            inboundIv[index] = receiveIvValue[index];
            outboundIv[index] = sendIvValue[index];
        }
        inboundInvocation = 0UL;
        outboundInvocation = 0UL;
        encrypted = true;
    }

    internal void ResetSequences()
    {
        inboundSequence = 0u;
        outboundSequence = 0u;
    }

    internal byte[] ReceivePacket(uint timeout)
    {
        byte[] header = new byte[4];
        ReceiveExact(header, 0, 4, timeout);
        uint packetLength = SshWire.ReadUInt32(header, 0);
        if (packetLength < 5u)
            throw new InvalidOperationException();
        if (packetLength > (uint)maximumPacket)
            throw new InvalidOperationException();
        if ((encrypted && packetLength % 16u != 0u) || (!encrypted && (packetLength + 4u) % 8u != 0u))
            throw new InvalidOperationException();
        byte[] body = new byte[(int)packetLength];
        if (encrypted)
        {
            if (inboundInvocation == 18446744073709551615UL)
                throw new InvalidOperationException();
            byte[] tag = new byte[16];
            ReceiveExact(body, 0, body.Length, timeout);
            ReceiveExact(tag, 0, tag.Length, timeout);
            byte[] nonce = Nonce(inboundIv, inboundInvocation);
            // The body stays private until authentication succeeds. Native
            // failure clears it before Require throws.
            SshNative.Require(SshNative.AesOpen(inboundCipher, nonce, header, body,
                tag, body));
            inboundInvocation++;
        }
        else
            ReceiveExact(body, 0, body.Length, timeout);
        inboundSequence++;
        int padding = body[0];
        if (padding < 4 || padding >= body.Length)
            throw new InvalidOperationException();
        int payloadLength = body.Length - padding - 1;
        byte[] payload = new byte[payloadLength];
        for (int index = 0; index < payloadLength; index++)
            payload[index] = body[index + 1];
        return payload;
    }

    internal void SendPacket(byte[] payload)
    {
        int block = 8;
        int framing = 5;
        if (encrypted)
        {
            block = 16;
            framing = 1;
        }
        int padding = block - ((payload.Length + framing) % block);
        if (padding < 4)
            padding += block;
        int packetLength = payload.Length + padding + 1;
        if (packetLength > maximumPacket)
            throw new InvalidOperationException();
        byte[] header = new byte[4];
        SshWire.WriteUInt32(header, 0, (uint)packetLength);
        byte[] body = new byte[packetLength];
        body[0] = (byte)padding;
        for (int index = 0; index < payload.Length; index++)
            body[index + 1] = payload[index];
        unsafe
        {
            NativeBuffer<byte> random = stackalloc byte[32];
            int left = padding;
            int offset = payload.Length + 1;
            while (left > 0)
            {
                int count = left;
                if (count > 32)
                    count = 32;
                SshNative.Require(SshNative.Random(random));
                for (int index = 0; index < count; index++)
                    body[offset + index] = random[(nuint)index];
                offset += count;
                left -= count;
            }
        }
        SendExact(header, 0, header.Length, 5000u);
        if (encrypted)
        {
            if (outboundInvocation == 18446744073709551615UL)
                throw new InvalidOperationException();
            byte[] nonce = Nonce(outboundIv, outboundInvocation);
            byte[] tag = new byte[16];
            SshNative.Require(SshNative.AesSeal(outboundCipher, nonce, header, body,
                body, tag));
            SendExact(body, 0, body.Length, 5000u);
            SendExact(tag, 0, tag.Length, 5000u);
            outboundInvocation++;
        }
        else
            SendExact(body, 0, body.Length, 5000u);
        outboundSequence++;
    }

    internal void Close()
    {
        if (inboundCipher != 0u)
        {
            SshNative.Close(inboundCipher);
            inboundCipher = 0u;
        }
        if (outboundCipher != 0u)
        {
            SshNative.Close(outboundCipher);
            outboundCipher = 0u;
        }
        if (socket != 0u)
        {
            SshNative.Shutdown(socket, 3u);
            SshNative.Close(socket);
            socket = 0u;
        }
    }

    private void ReceiveExact(byte[] data, int offset, int count, uint timeout)
    {
        int received = 0;
        while (received < count)
        {
            int value = SshNative.Receive(socket, data, offset + received, count
                - received, timeout);
            if (value <= 0)
                throw new InvalidOperationException();
            received += value;
            bytesReceived += value;
        }
    }

    private void SendExact(byte[] data, int offset, int count, uint timeout)
    {
        int sent = 0;
        while (sent < count)
        {
            int result = SshNative.Send(socket, data, offset + sent, count - sent,
                timeout);
            if (result <= 0)
                throw new InvalidOperationException();
            sent += result;
            bytesSent += result;
        }
    }

    private static byte[] Nonce(byte[] basis, ulong invocation)
    {
        byte[] result = new byte[12];
        for (int index = 0; index < 12; index++)
            result[index] = basis[index];
        ulong carry = invocation;
        for (int index = 11; index >= 4; index--)
        {
            uint sum = (uint)result[index] + (uint)(carry & 255UL);
            result[index] = (byte)sum;
            carry = (carry >> 8) + (ulong)(sum >> 8);
        }
        return result;
    }
}
