using System;
using System.Diagnostics;
using System.IO;
using System.Text;
using System.Threading;
using Esp.Idf;

namespace Examples.ManagedShell;

internal static class ShellPlatform
{
    [Extern("ct_managed_shell_initialize")]
    internal static int Initialize();

    [Extern("ct_managed_shell_print_modules")]
    [NoAlloc]
    [NoThrow]
    internal static void PrintModules();

    [Extern("ct_managed_shell_print_processes")]
    [NoAlloc]
    [NoThrow]
    internal static void PrintProcesses();

    [Extern("ct_managed_shell_print_free_heap")]
    [NoAlloc]
    [NoThrow]
    internal static void PrintFreeHeap();
}

internal enum ShellLedColor
{
    Orange, Blue, Green, Red, White,
}

public static class ShellLed
{
    private const int Ws2812Pin = 4;
    private const int MaximumProcesses = 16;
    private const long InputPulseNanoseconds = 100000000L;
    private const uint PollMilliseconds = 5u;
    private static Atomic<int> enabled = new Atomic<int>(0);
    private static Atomic<int> started = new Atomic<int>(0);
    private static Atomic<int> initializationComplete = new Atomic<int>(0);
    private static Atomic<int> baseColor = new Atomic<int>((int)ShellLedColor.Orange);
    private static Atomic<int> inputGeneration = new Atomic<int>(0);
    private static Atomic<int> updateFailureCode = new Atomic<int>(0);
    private static Mutex processGate;
    private static Process[] trackedProcesses;
    private static Thread worker;
    private static EspError initializationResult;
    private static int activeProcesses;
    private static bool batchFailed;

    public static EspError InitializeOrange()
    {
        processGate = new Mutex();
        trackedProcesses = new Process[MaximumProcesses];
        activeProcesses = 0;
        batchFailed = false;
        worker = new Thread(UpdateLoop, 4096u, ThreadPriority.BelowNormal);
        worker.Start();
        while (initializationComplete.Load(MemoryOrder.Acquire) == 0)
            Thread.Yield();
        return initializationResult;
    }

    public static void PromptStarted()
    {
        if (started.Load(MemoryOrder.Acquire) == 0)
            return;
        lock (processGate)
        {
            UpdateBaseColor();
        }
    }

    public static void ProcessStarting()
    {
        if (started.Load(MemoryOrder.Acquire) == 0)
            return;
        lock (processGate)
        {
            if (activeProcesses == 0)
                batchFailed = false;
            activeProcesses++;
            baseColor.Store((int)ShellLedColor.Green, MemoryOrder.Release);
        }
    }

    public static void ProcessStarted(Process process)
    {
        if (started.Load(MemoryOrder.Acquire) == 0)
            return;
        lock (processGate)
        {
            int index = 0;
            while (index < trackedProcesses.Length)
            {
                Process tracked = trackedProcesses[index];
                if (tracked != null && tracked.HasExited)
                    CompleteProcess(index, tracked.ExitCode);
                if (trackedProcesses[index] == null)
                {
                    trackedProcesses[index] = process;
                    return;
                }
                index++;
            }
            batchFailed = true;
            activeProcesses--;
            UpdateBaseColor();
        }
    }

    public static void ProcessStartFailed()
    {
        if (started.Load(MemoryOrder.Acquire) == 0)
            return;
        lock (processGate)
        {
            if (activeProcesses > 0)
                activeProcesses--;
            batchFailed = true;
            UpdateBaseColor();
        }
    }

    [Export("ct_managed_shell_input_activity")]
    [NoAlloc]
    public static void InputActivity()
    {
        inputGeneration.FetchAdd(1, MemoryOrder.Release);
    }

    [NoAlloc]
    public static int TakeUpdateFailureCode()
    {
        return updateFailureCode.Exchange(0, MemoryOrder.AcquireRelease);
    }

    private static void CompleteProcess(int index, int exitCode)
    {
        trackedProcesses[index] = null;
        if (activeProcesses > 0)
            activeProcesses--;
        if (exitCode != 0)
            batchFailed = true;
    }

    private static void PollProcesses()
    {
        lock (processGate)
        {
            int index = 0;
            while (index < trackedProcesses.Length)
            {
                Process process = trackedProcesses[index];
                if (process != null && process.HasExited)
                    CompleteProcess(index, process.ExitCode);
                index++;
            }
            UpdateBaseColor();
        }
    }

    private static void UpdateBaseColor()
    {
        if (activeProcesses > 0)
            baseColor.Store((int)ShellLedColor.Green, MemoryOrder.Release);
        else if (batchFailed)
            baseColor.Store((int)ShellLedColor.Red, MemoryOrder.Release);
        else
            baseColor.Store((int)ShellLedColor.Blue, MemoryOrder.Release);
    }

    private static EspError Display(int color)
    {
        EspError result;
        if (color == (int)ShellLedColor.Orange)
            result = Ws2812.SetPixel(0u, 16u, 8u, 0u);
        else if (color == (int)ShellLedColor.Blue)
            result = Ws2812.SetPixel(0u, 0u, 0u, 16u);
        else if (color == (int)ShellLedColor.Green)
            result = Ws2812.SetPixel(0u, 0u, 16u, 0u);
        else if (color == (int)ShellLedColor.Red)
            result = Ws2812.SetPixel(0u, 16u, 0u, 0u);
        else
            result = Ws2812.SetPixel(0u, 16u, 16u, 16u);
        if (!result.IsSuccess)
            return result;
        return Ws2812.Refresh();
    }

    private static void UpdateLoop()
    {
        EspError result = Ws2812.Configure(Ws2812Pin, 1u);
        if (result.IsSuccess)
            result = Display((int)ShellLedColor.Orange);
        initializationResult = result;
        if (!result.IsSuccess)
        {
            initializationComplete.Store(1, MemoryOrder.Release);
            return;
        }
        enabled.Store(1, MemoryOrder.Release);
        started.Store(1, MemoryOrder.Release);
        initializationComplete.Store(1, MemoryOrder.Release);
        int observedInput = inputGeneration.Load(MemoryOrder.Acquire);
        int displayedColor = (int)ShellLedColor.Orange;
        long whiteUntil = 0L;
        while (enabled.Load(MemoryOrder.Acquire) != 0)
        {
            PollProcesses();
            long now = Stopwatch.GetTimestampNanoseconds();
            int currentInput = inputGeneration.Load(MemoryOrder.Acquire);
            if (currentInput != observedInput)
            {
                observedInput = currentInput;
                whiteUntil = now + InputPulseNanoseconds;
            }
            int desiredColor = baseColor.Load(MemoryOrder.Acquire);
            if (now < whiteUntil)
                desiredColor = (int)ShellLedColor.White;
            if (desiredColor != displayedColor)
            {
                EspError updateResult = Display(desiredColor);
                if (!updateResult.IsSuccess)
                {
                    updateFailureCode.Store(updateResult.Code, MemoryOrder.Release);
                    enabled.Store(0, MemoryOrder.Release);
                    return;
                }
                displayedColor = desiredColor;
            }
            Thread.Sleep(PollMilliseconds);
        }
    }
}

public static class Program
{
    private static Process[] processes = new Process[16];
    private static int processCount;

    private static void Help()
    {
        Console.WriteLine("commands: ls [path], modules, ps, kill <id>, wait <id>, send <id> <text>, free, help");
        Console.WriteLine("applications: program.ctm [args] or program.ctm [args] &");
        Console.WriteLine("examples: memory.ctm, taskmgr.ctm [kill <id>], sd.ctm help, nano.ctm <path>");
    }

    private static Process FindProcess(uint id)
    {
        int index = 0;
        while (index < processCount)
        {
            Process process = processes[index];
            if (process != null && process.Id == id)
                return process;
            index++;
        }
        return null;
    }

    private static void ListFiles(string[] words)
    {
        if (words.Length > 2)
        {
            Console.WriteLine("usage: ls [path]");
            return;
        }
        if (words.Length == 2)
        {
            if (!Directory.Exists(words[1]))
            {
                Console.Write("ls: directory not found: ");
                Console.WriteLine(words[1]);
                return;
            }
            ListFilesAt(words[1], words[1]);
            return;
        }
        if (Directory.Exists("/sd"))
            ListFilesAt("/sd", "SD");
        ListFilesAt("/storage/modules", "LittleFS");
    }

    private static void ListFilesAt(string path, string label)
    {
        if (!Directory.Exists(path))
            return;
        Console.Write(label);
        Console.WriteLine(":");
        string[] entries = Directory.GetFileSystemEntries(path);
        int index = 0;
        while (index < entries.Length)
        {
            Console.WriteLine(entries[index]);
            index++;
        }
    }

    private static string[] Arguments(string[] words, int start)
    {
        string[] result = new string[words.Length - start];
        int index = start;
        while (index < words.Length)
        {
            result[index - start] = words[index];
            index++;
        }
        return result;
    }

    private static bool TryId(string text, out uint id)
    {
        id = 0u;
        return uint.TryParse(text, out id);
    }

    private static void Execute(string[] words, bool background)
    {
        int slot = -1;
        if (background)
        {
            slot = processCount;
            if (slot == processes.Length)
            {
                slot = 0;
                while (slot < processCount && !processes[slot].HasExited)
                    slot++;
                if (slot == processCount)
                {
                    Console.WriteLine("process handle table is full");
                    return;
                }
            }
        }
        string path = words[0];
        ShellLed.ProcessStarting();
        Process process = Process.Start(path, Arguments(words, 1));
        if (process.Id == 0u)
        {
            ShellLed.ProcessStartFailed();
            Console.WriteLine("module load failed");
            return;
        }
        ShellLed.ProcessStarted(process);
        if (background)
        {
            processes[slot] = process;
            if (processCount < processes.Length)
                processCount++;
            Console.Write("started process ");
            Console.WriteLine(process.Id);
            return;
        }
        int exitCode = process.Wait();
        if (exitCode != 0)
        {
            Console.Write("exit code: ");
            Console.WriteLine(exitCode);
        }
    }

    private static void Kill(string[] words)
    {
        uint id;
        if (words.Length != 2 || !TryId(words[1], out id))
        {
            Console.WriteLine("usage: kill <id>");
            return;
        }
        Process process = FindProcess(id);
        if (process == null)
        {
            Console.WriteLine("process not found");
            return;
        }
        process.Terminate(1000u);
    }

    private static void Wait(string[] words)
    {
        uint id;
        if (words.Length != 2 || !TryId(words[1], out id))
        {
            Console.WriteLine("usage: wait <id>");
            return;
        }
        Process process = FindProcess(id);
        if (process == null)
        {
            Console.WriteLine("process not found");
            return;
        }
        Console.Write("exit code: ");
        Console.WriteLine(process.Wait());
    }

    private static void Send(string[] words)
    {
        uint id;
        if (words.Length < 3 || !TryId(words[1], out id))
        {
            Console.WriteLine("usage: send <id> <text>");
            return;
        }
        Process process = FindProcess(id);
        if (process == null)
        {
            Console.WriteLine("process not found");
            return;
        }
        string payload = words[2];
        int index = 3;
        while (index < words.Length)
        {
            payload = payload + " " + words[index];
            index++;
        }
        process.Send(Encoding.UTF8.GetBytes(payload));
    }

    private static void Dispatch(string line)
    {
        string[] words;
        bool background;
        if (!ShellCommandLine.TryParse(line, out words, out background))
        {
            Console.WriteLine("syntax error: malformed quoting or escape");
            return;
        }
        if (words.Length == 0)
            return;
        string command = words[0];
        if (background && !command.EndsWith(".ctm"))
        {
            Console.WriteLine("syntax error: '&' is valid only for applications");
            return;
        }
        if (command == "help")
            Help();
        else if (command == "ls")
            ListFiles(words);
        else if (command == "modules")
            ShellPlatform.PrintModules();
        else if (command == "ps")
            ShellPlatform.PrintProcesses();
        else if (command == "kill")
            Kill(words);
        else if (command == "wait")
            Wait(words);
        else if (command == "send")
            Send(words);
        else if (command == "free")
            ShellPlatform.PrintFreeHeap();
        else if (command.EndsWith(".ctm"))
            Execute(words, background);
        else
            Console.WriteLine("unknown command");
    }

    [EntryPoint]
    public static void Main()
    {
        EspError ledResult = ShellLed.InitializeOrange();
        if (ShellPlatform.Initialize() != 0)
            return;
        if (!ledResult.IsSuccess)
        {
            Console.Write("LED initialization failed: ");
            Console.WriteLine(ledResult.GetName());
        }
        Console.WriteLine("CTilde managed shell - Runtime ABI 22 / Module ABI 3");
        Help();
        while (true)
        {
            ShellLed.PromptStarted();
            int ledFailure = ShellLed.TakeUpdateFailureCode();
            if (ledFailure != 0)
            {
                Console.Write("LED update failed: ");
                Console.WriteLine(ledFailure);
            }
            string line = Console.ReadLine("ct> ");
            if (line == null)
                return;
            Dispatch(line);
        }
    }
}
