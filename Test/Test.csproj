<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CTilde.Tests</AssemblyName>
    <RootNamespace>CTilde.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Conformance/**/*.cs" />
    <ProjectReference Include="../CTilde/CTilde.csproj" />
    <ProjectReference Include="../CTilde.Cli/CTilde.Cli.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../examples/*.ct" Link="Examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../examples/HostedIo/*.ct" Link="Examples/HostedIo/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Snapshots/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
