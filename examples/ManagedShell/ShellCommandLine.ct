using System;
using System.Text;

namespace Examples.ManagedShell;

public static class ShellCommandLine
{
    private static bool IsWhitespace(char value)
    {
        return value == ' ' || value == '\t' || value == '\r' || value == '\n';
    }

    private static bool TryEscape(char value, out char result)
    {
        result = value;
        if (value == '"' || value == '\\')
            return true;
        if (value == 't')
        {
            result = '\t';
            return true;
        }
        if (value == 'r')
        {
            result = '\r';
            return true;
        }
        if (value == 'n')
        {
            result = '\n';
            return true;
        }
        return false;
    }

    private static bool TryParsePass(string line, string[] values, bool[] quoted,
        bool emit, out int count)
    {
        count = 0;
        int position = 0;
        while (position < line.Length)
        {
            while (position < line.Length && IsWhitespace(line[position]))
                position++;
            if (position == line.Length)
                break;
            StringBuilder value = new StringBuilder();
            bool inQuotes = false;
            bool wasQuoted = false;
            bool started = false;
            while (position < line.Length && (inQuotes || !IsWhitespace(line[position])))
            {
                char current = line[position++];
                if (current == '"')
                {
                    inQuotes = !inQuotes;
                    wasQuoted = true;
                    started = true;
                }
                else if (current == '\\')
                {
                    if (position == line.Length)
                        return false;
                    char escaped;
                    if (!TryEscape(line[position++], out escaped))
                        return false;
                    value.Append(escaped);
                    started = true;
                }
                else
                {
                    value.Append(current);
                    started = true;
                }
            }
            if (inQuotes)
                return false;
            if (started)
            {
                if (emit)
                {
                    values[count] = value.ToString();
                    quoted[count] = wasQuoted;
                }
                count++;
            }
        }
        return true;
    }

    public static bool TryParse(string line, out string[] arguments, out bool background)
    {
        int count;
        if (!TryParsePass(line, null, null, false, out count))
        {
            arguments = new string[0];
            background = false;
            return false;
        }
        string[] values = new string[count];
        bool[] quoted = new bool[count];
        int parsedCount;
        if (!TryParsePass(line, values, quoted, true, out parsedCount))
        {
            arguments = new string[0];
            background = false;
            return false;
        }
        background = parsedCount > 0 && values[parsedCount - 1] == "&" && !quoted[parsedCount
            - 1];
        if (background)
            parsedCount--;
        arguments = new string[parsedCount];
        int index = 0;
        while (index < parsedCount)
        {
            arguments[index] = values[index];
            index++;
        }
        return true;
    }
}
