using System;
using System.IO;
using System.Text;

namespace System.Ssh;

internal sealed class SshConfiguration
{
    internal string UserName;
    internal int Port;
}

internal sealed class AuthorizedKeySet
{
    private AuthorizedKey[] keys;
    private int count;

    internal AuthorizedKeySet()
    {
        keys = new AuthorizedKey[32];
    }

    internal int Count { get { return count; } }

    internal void Add(byte[] key)
    {
        if (count >= keys.Length) throw new InvalidOperationException();
        for (int index = 0; index < count; index++)
            if (Equal(keys[index].Blob, key)) throw new InvalidOperationException();
        AuthorizedKey entry = new AuthorizedKey();
        entry.Blob = key;
        keys[count++] = entry;
    }

    internal bool Contains(byte[] key)
    {
        for (int index = 0; index < count; index++)
            if (Equal(keys[index].Blob, key)) return true;
        return false;
    }

    private static bool Equal(byte[] left, byte[] right)
    {
        if (left.Length != right.Length) return false;
        int difference = 0;
        for (int index = 0; index < left.Length; index++)
            difference = difference | (int)(left[index] ^ right[index]);
        return difference == 0;
    }
}

internal sealed class AuthorizedKey
{
    internal byte[] Blob;
}

[Overlay("configuration")]
internal static class SshConfigurationLoader
{
    internal static SshConfiguration Load(string path, string defaultUser, int defaultPort)
    {
        SshConfiguration result = new SshConfiguration();
        result.UserName = defaultUser;
        result.Port = defaultPort;
        if (!File.Exists(path)) return result;
        byte[] bytes = File.ReadAllBytes(path);
        if (bytes.Length > 4096) throw new InvalidOperationException();
        string[] lines = Encoding.UTF8.GetString(bytes).Split('\n');
        bool sawUser = false;
        bool sawPort = false;
        for (int index = 0; index < lines.Length; index++)
        {
            string line = lines[index].Trim(' ');
            if (line.EndsWith("\r")) line = line.Substring(0, line.Length - 1);
            if (line.Length == 0 || line.StartsWith("#")) continue;
            int equals = line.IndexOf('=');
            if (equals <= 0 || equals == line.Length - 1) throw new InvalidOperationException();
            string name = line.Substring(0, equals).Trim(' ');
            string value = line.Substring(equals + 1).Trim(' ');
            if (name == "user")
            {
                if (sawUser || !ValidUser(value)) throw new InvalidOperationException();
                result.UserName = value;
                sawUser = true;
            }
            else if (name == "port")
            {
                int port;
                if (sawPort || !int.TryParse(value, out port) || port < 1 || port > 65535)
                    throw new InvalidOperationException();
                result.Port = port;
                sawPort = true;
            }
            else throw new InvalidOperationException();
        }
        return result;
    }

    internal static AuthorizedKeySet LoadAuthorizedKeys(string path)
    {
        if (!File.Exists(path)) throw new InvalidOperationException();
        byte[] bytes = File.ReadAllBytes(path);
        if (bytes.Length > 65536) throw new InvalidOperationException();
        string[] lines = Encoding.UTF8.GetString(bytes).Split('\n');
        AuthorizedKeySet result = new AuthorizedKeySet();
        for (int index = 0; index < lines.Length; index++)
        {
            string line = lines[index].Trim(' ');
            if (line.EndsWith("\r")) line = line.Substring(0, line.Length - 1);
            if (line.Length == 0 || line.StartsWith("#")) continue;
            if (!line.StartsWith("ecdsa-sha2-nistp256 ")) throw new InvalidOperationException();
            int end = line.IndexOf(' ', 21);
            string encoded;
            if (end < 0) encoded = line.Substring(21);
            else encoded = line.Substring(21, end - 21);
            byte[] blob = DecodeBase64(encoded);
            ValidatePublicBlob(blob);
            result.Add(blob);
        }
        if (result.Count == 0) throw new InvalidOperationException();
        return result;
    }

    private static bool ValidUser(string value)
    {
        if (value.Length < 1 || value.Length > 32) return false;
        for (int index = 0; index < value.Length; index++)
            if (value[index] < '!' || value[index] > '~') return false;
        return true;
    }

    private static int Base64Value(char value)
    {
        if (value >= 'A' && value <= 'Z') return value - 'A';
        if (value >= 'a' && value <= 'z') return value - 'a' + 26;
        if (value >= '0' && value <= '9') return value - '0' + 52;
        if (value == '+') return 62;
        if (value == '/') return 63;
        return -1;
    }

    internal static byte[] DecodeBase64(string value)
    {
        if (value.Length == 0 || value.Length % 4 != 0) throw new InvalidOperationException();
        int padding = 0;
        if (value[value.Length - 1] == '=') padding++;
        if (value[value.Length - 2] == '=') padding++;
        byte[] result = new byte[value.Length / 4 * 3 - padding];
        int output = 0;
        for (int index = 0; index < value.Length; index += 4)
        {
            int a = Base64Value(value[index]);
            int b = Base64Value(value[index + 1]);
            int c = 0;
            int d = 0;
            if (value[index + 2] != '=') c = Base64Value(value[index + 2]);
            if (value[index + 3] != '=') d = Base64Value(value[index + 3]);
            if (a < 0 || b < 0 || c < 0 || d < 0) throw new InvalidOperationException();
            uint bits = (uint)(a << 18 | b << 12 | c << 6 | d);
            if (output < result.Length) result[output++] = (byte)(bits >> 16);
            if (output < result.Length) result[output++] = (byte)(bits >> 8);
            if (output < result.Length) result[output++] = (byte)bits;
            if ((value[index + 2] == '=' || value[index + 3] == '=') && index + 4 != value.Length)
                throw new InvalidOperationException();
        }
        return result;
    }

    internal static void ValidatePublicBlob(byte[] blob)
    {
        SshPacketReader reader = new SshPacketReader(blob);
        if (reader.ReadString() != "ecdsa-sha2-nistp256") throw new InvalidOperationException();
        if (reader.ReadString() != "nistp256") throw new InvalidOperationException();
        byte[] point = reader.ReadBytes();
        if (point.Length != 65 || point[0] != 4) throw new InvalidOperationException();
        reader.RequireEnd();
        uint token;
        SshNative.Require(SshNative.P256PublicImport(point, out token));
        SshNative.Close(token);
    }
}
