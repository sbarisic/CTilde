namespace System.Runtime;

public enum TargetProfile
{
    Hosted, EspIdf, Freestanding, Cosmopolitan
}

public enum TargetEnvironment
{
    Native, Qemu
}

public enum Runtime
{
    Allocate, Free, Panic, Exit, ConsoleWrite, ConsoleRead, ConsoleFlush, MonotonicNanoseconds,
        PathSeparator, MathFloatUnary, MathFloatBinary, MathDoubleUnary, MathDoubleBinary,
        FileOpen, FileRead, FileWrite, FileSeek, FileLength, FileSetLength, FileFlush,
        FileClose, PathMetadata, FileDelete, PathMove, DirectoryCreate, DirectoryDelete,
        DirectoryOpen, DirectoryRead, DirectoryClose, CurrentDirectoryGet, CurrentDirectorySet,
        ThreadCreate, ThreadJoin, ThreadClose, ThreadSleep, ThreadYield, ThreadStateGet,
        ThreadStateSet, MutexCreate, MutexEnter, MutexTryEnter, MutexExit, MutexClose
}

public enum RuntimeStatus : byte
{
    Success, EndOfStream, BufferTooSmall, NotFound, AlreadyExists, AccessDenied,
        InvalidArgument, NotSupported, Busy, TimedOut, OutOfMemory, IoError
}

public readonly struct RuntimeResult
{
    public readonly RuntimeStatus Status;
    public readonly int NativeCode;

    public RuntimeResult(RuntimeStatus status, int nativeCode)
    {
        Status = status;
        NativeCode = nativeCode;
    }

    public static RuntimeResult Ok
    {
        get
        {
            return new RuntimeResult(RuntimeStatus.Success, 0);
        }
    }
}

public readonly struct RuntimeTransferResult
{
    public readonly RuntimeStatus Status;
    public readonly int NativeCode;
    public readonly nuint Count;

    public RuntimeTransferResult(RuntimeStatus status, int nativeCode, nuint count)
    {
        Status = status;
        NativeCode = nativeCode;
        Count = count;
    }
}

public enum RuntimeFileMode : byte
{
    Open, Create, Append, CreateNew, OpenOrCreate, Truncate
}

public enum RuntimeFileAccess : byte
{
    Read, Write, ReadWrite
}

public enum RuntimeSeekOrigin : byte
{
    Begin, Current, End
}

public enum RuntimeFileKind : byte
{
    None, File, Directory, SymbolicLink, Other
}

public enum RuntimeFileAttributes : uint
{
    None=0, ReadOnly=1, Hidden=2, Directory=4, SymbolicLink=8
}

public struct RuntimeFileTimestamp
{
    public long Seconds;
    public int Nanoseconds;
}

public struct RuntimeFileMetadata
{
    public RuntimeFileKind Kind;
    public RuntimeFileAttributes Attributes;
    public long Length;
    public bool HasCreationTime;
    public RuntimeFileTimestamp CreationTime;
    public bool HasAccessTime;
    public RuntimeFileTimestamp AccessTime;
    public bool HasModificationTime;
    public RuntimeFileTimestamp ModificationTime;
}

public enum RuntimeUnaryMathOperation : byte
{
    SquareRoot, Absolute, Tangent, Sine, Cosine, ArcCosine, Floor, Ceiling, ArcSine,
        ArcTangent, Exponential, Logarithm, Logarithm2, Logarithm10, Round, Truncate
}

public enum RuntimeBinaryMathOperation : byte
{
    Minimum, Maximum, ArcTangent2, Power
}

public enum RuntimeThreadPriority : byte
{
    Lowest, BelowNormal, Normal, AboveNormal, Highest
}

public readonly struct RuntimePanicInfo
{
    public unsafe readonly byte* Code;
    public unsafe readonly byte* File;
    public readonly int Line;
    public readonly RuntimeStatus Status;
    public readonly int NativeCode;
}

public enum TargetArchitecture
{
    X86, X64, Arm32, Arm64, Xtensa, RiscV32, RiscV64
}

public enum CpuFeature
{
    Simd128
}

public static class Target
{
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static TargetProfile Profile
    {
        get
        {
            return TargetProfile.Hosted;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static TargetEnvironment Environment
    {
        get
        {
            return TargetEnvironment.Native;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static TargetArchitecture Architecture
    {
        get
        {
            return TargetArchitecture.X86;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int PointerSize
    {
        get
        {
            return 4;
        }
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static bool HasFeature(CpuFeature feature)
    {
        return false;
    }
}

public static class Mmio
{
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static unsafe T Read<T>(nuint address) where T : unmanaged
    {
        return(T)0;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static unsafe void Write<T>(nuint address, T value) where T : unmanaged
    {
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static unsafe T ReadRelaxed<T>(nuint address) where T : unmanaged
    {
        return(T)0;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static unsafe void WriteRelaxed<T>(nuint address, T value) where T : unmanaged
    {
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static unsafe void Barrier()
    {
    }
}

public static class Cpu
{
    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static void MemoryBarrier()
    {
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static void Pause()
    {
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static ushort ByteSwap(ushort value)
    {
        return value;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static uint ByteSwap(uint value)
    {
        return value;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static ulong ByteSwap(ulong value)
    {
        return value;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int PopCount(uint value)
    {
        return 0;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int PopCount(ulong value)
    {
        return 0;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int LeadingZeroCount(uint value)
    {
        return 0;
    }

    [NoAlloc]
    [NoThrow]
    [NoBlock]
    [NoRuntime]
    public static int LeadingZeroCount(ulong value)
    {
        return 0;
    }
}
