using System;
using System.Diagnostics;
using System.Text;

public static class Program
{
    private static int invocationCount;

    private static int Listen(Process current)
    {
        Console.WriteLine("listening for copied messages");
        while (!Process.IsCancellationRequested)
        {
            byte[] payload;
            if (current.TryReceive(250u, out payload))
            {
                string message = Encoding.UTF8.GetString(payload);
                Console.Write("message: ");
                Console.WriteLine(message);
                if (message == "exit")
                    return 0;
            }
        }
        Console.WriteLine("cancellation observed");
        return -1;
    }

    [EntryPoint]
    public static int Main(string[] args)
    {
        Process current = Process.Current;
        if (current == null)
            return -2;
        invocationCount++;
        Console.Write("hello from managed process ");
        Console.Write(current.Id);
        Console.Write(" invocation #");
        Console.WriteLine(invocationCount);
        Console.Write("arguments: ");
        Console.WriteLine(args.Length);
        if (Process.IsCancellationRequested)
            return -1;
        if (args.Length > 0 && args[0] == "listen")
            return Listen(current);
        return args.Length;
    }
}
