using System;
using System.Simd;

namespace HostedIoExample;

public struct Interval
{
    public float Min;
    public float Max;

    public Interval(float min, float max)
    {
        Min = min;
        Max = max;
    }

    [NoAlloc]
    public bool Contains(float value)
    {
        return Min <= value && value <= Max;
    }

    [NoAlloc]
    public bool Surrounds(float value)
    {
        return Min < value && value < Max;
    }

    [NoAlloc]
    public float Clamp(float value)
    {
        return Math.Min(Math.Max(value, Min), Max);
    }
}

public struct RayInterval4
{
    public F32x4 Min;
    public F32x4 Max;

    public RayInterval4(F32x4 min, F32x4 max)
    {
        Min = min;
        Max = max;
    }

    [NoAlloc]
    public static RayInterval4 Splat(float min, float max)
    {
        return new RayInterval4(F32x4.Splat(min), F32x4.Splat(max));
    }
}

public struct Ray
{
    public Vec3 Origin;
    public Vec3 Direction;

    public Ray(Vec3 origin, Vec3 direction)
    {
        Origin = origin;
        Direction = direction;
    }

    [NoAlloc]
    public Vec3 At(float distance)
    {
        return Origin + Direction * distance;
    }
}

public struct RayPacket
{
    public Vec3x4 Origins;
    public Vec3x4 Directions;

    public RayPacket(Vec3x4 origins, Vec3x4 directions)
    {
        Origins = origins;
        Directions = directions;
    }

    [NoAlloc]
    public static RayPacket Create(Ray lane0, Ray lane1, Ray lane2, Ray lane3)
    {
        Vec3x4 origins = Vec3x4.Zero.WithLane<0>(lane0.Origin).WithLane<1>(lane1.Origin).WithLane<2>(lane2.Origin).WithLane<3>(lane3.Origin);
        Vec3x4 directions = Vec3x4.Zero.WithLane<0>(lane0.Direction).WithLane<1>(lane1.Direction).WithLane<2>(lane2.Direction).WithLane<3>(lane3.Direction);
        return new RayPacket(origins, directions);
    }

    [NoAlloc]
    public Ray GetLane<const int Lane>()
    {
        return new Ray(Origins.GetLane<Lane>(), Directions.GetLane<Lane>());
    }

    [NoAlloc]
    public Vec3x4 At(F32x4 distance)
    {
        return Origins + Directions * distance;
    }
}

public static class PacketMasks
{
    [NoAlloc]
    public static Mask32x4 First(int count)
    {
        return F32x4.CompareLessThan(F32x4.Create(0.0f, 1.0f, 2.0f, 3.0f), F32x4.Splat((float)count));
    }

    [NoAlloc]
    public static Mask32x4 FromBools(bool lane0, bool lane1, bool lane2, bool lane3)
    {
        return F32x4.CompareGreaterThan(F32x4.Create(ToFloat(lane0), ToFloat(lane1),
            ToFloat(lane2), ToFloat(lane3)), F32x4.Zero);
    }

    [NoAlloc]
    public static float FirstValue(F32x4 values, Mask32x4 active, float fallback)
    {
        uint lanes = active.MoveMask();
        if ((lanes & 1u) != 0u)
            return values.GetLane<0>();
        if ((lanes & 2u) != 0u)
            return values.GetLane<1>();
        if ((lanes & 4u) != 0u)
            return values.GetLane<2>();
        if ((lanes & 8u) != 0u)
            return values.GetLane<3>();
        return fallback;
    }

    [NoAlloc]
    private static float ToFloat(bool value)
    {
        if (value)
            return 1.0f;
        return 0.0f;
    }
}

public static class VectorMath
{
    [NoAlloc]
    public static bool NearZero(Vec3 value)
    {
        const float threshold = 0.00000001f;
        return Math.Abs(value.X) < threshold && Math.Abs(value.Y) < threshold && Math.Abs(value.Z)
            < threshold;
    }

    [NoAlloc]
    public static Vec3 Reflect(Vec3 direction, Vec3 normal)
    {
        return direction - 2.0f * direction.Dot(normal) * normal;
    }

    [NoAlloc]
    public static Vec3 Refract(Vec3 unitDirection, Vec3 normal, float refractionRatio)
    {
        float cosine = Math.Min((-unitDirection).Dot(normal), 1.0f);
        Vec3 perpendicular = refractionRatio * (unitDirection + cosine * normal);
        Vec3 parallel = -Math.Sqrt(Math.Abs(1.0f - perpendicular.LengthSquared()))
            * normal;
        return perpendicular + parallel;
    }

    [NoAlloc]
    public static Vec3x4 Reflect(Vec3x4 direction, Vec3x4 normal)
    {
        return direction - normal * (direction.Dot(normal) * F32x4.Splat(2.0f));
    }

    [NoAlloc]
    public static Vec3x4 Refract(Vec3x4 unitDirection, Vec3x4 normal, F32x4 refractionRatio)
    {
        F32x4 cosine = F32x4.Min((-unitDirection).Dot(normal), F32x4.Splat(1.0f));
        Vec3x4 perpendicular = (unitDirection + normal * cosine) * refractionRatio;
        F32x4 parallelScale = -F32x4.Sqrt(F32x4.Abs(F32x4.Splat(1.0f) - perpendicular.LengthSquared()));
        return perpendicular + normal * parallelScale;
    }
}
