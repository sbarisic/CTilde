using System;

namespace HostedIoExample;

public struct Interval
{
    public float Min;
    public float Max;

    public Interval(float min, float max)
    {
        Min = min;
        Max = max;
    }

    [NoAlloc]
    public bool Contains(float value)
    {
        return Min <= value && value <= Max;
    }

    [NoAlloc]
    public bool Surrounds(float value)
    {
        return Min < value && value < Max;
    }

    [NoAlloc]
    public float Clamp(float value)
    {
        return Math.Min(Math.Max(value, Min), Max);
    }
}

public struct Ray
{
    public Vec3 Origin;
    public Vec3 Direction;

    public Ray(Vec3 origin, Vec3 direction)
    {
        Origin = origin;
        Direction = direction;
    }

    [NoAlloc]
    public Vec3 At(float distance)
    {
        return Origin + Direction * distance;
    }
}

public static class VectorMath
{
    [NoAlloc]
    public static bool NearZero(Vec3 value)
    {
        const float threshold = 0.00000001f;
        return Math.Abs(value.X) < threshold &&
            Math.Abs(value.Y) < threshold &&
            Math.Abs(value.Z) < threshold;
    }

    [NoAlloc]
    public static Vec3 Reflect(Vec3 direction, Vec3 normal)
    {
        return direction - 2.0f * direction.Dot(normal) * normal;
    }

    [NoAlloc]
    public static Vec3 Refract(Vec3 unitDirection, Vec3 normal, float refractionRatio)
    {
        float cosine = Math.Min((-unitDirection).Dot(normal), 1.0f);
        Vec3 perpendicular = refractionRatio * (unitDirection + cosine * normal);
        Vec3 parallel = -Math.Sqrt(Math.Abs(1.0f - perpendicular.LengthSquared())) * normal;
        return perpendicular + parallel;
    }
}
