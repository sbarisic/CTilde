{
  "target": "freestanding",
  "architecture": "x64",
  "sources": ["src/Kernel.ct", "src/NakedStart.ct"],
  "build": {
    "cLayout": "modules",
    "compiler": "wsl:gcc",
    "configuration": "release",
    "image": "build/kernel.elf"
  },
  "freestanding": {
    "linkerScript": "native/kernel.ld",
    "entrySymbol": "_start",
    "nativeSources": ["native/platform.c"],
    "objectFiles": [],
    "libraries": [],
    "compileOptions": ["-mno-red-zone"],
    "linkOptions": ["-Wl,--build-id=none"]
  }
}
