namespace HostedIoExample;

public struct Rgba32
{
    public byte Red;
    public byte Green;
    public byte Blue;
    public byte Alpha;

    [NoAlloc]
    public Rgba32(byte red, byte green, byte blue, byte alpha)
    {
        Red = red;
        Green = green;
        Blue = blue;
        Alpha = alpha;
    }

    [NoAlloc]
    public static Rgba32 Black()
    {
        return new Rgba32((byte)0, (byte)0, (byte)0, (byte)255);
    }

    [NoAlloc]
    public static Rgba32 White()
    {
        return new Rgba32((byte)255, (byte)255, (byte)255, (byte)255);
    }
}

public struct PixelPacket
{
    public Rgba32 Lane0;
    public Rgba32 Lane1;
    public Rgba32 Lane2;
    public Rgba32 Lane3;
    public int Count;

    [NoAlloc]
    public PixelPacket(Rgba32 lane0, Rgba32 lane1, Rgba32 lane2, Rgba32 lane3, int count)
    {
        Lane0 = lane0;
        Lane1 = lane1;
        Lane2 = lane2;
        Lane3 = lane3;
        Count = count;
    }
}

public static class PixelBuffer
{
    [NoAlloc]
    public static uint Checksum(Rgba32[] pixels)
    {
        uint hash = 2166136261u;
        int index = 0;
        while (index < pixels.Length)
        {
            Rgba32 pixel = pixels[index];
            hash = (hash ^ (uint)pixel.Red) * 16777619u;
            hash = (hash ^ (uint)pixel.Green) * 16777619u;
            hash = (hash ^ (uint)pixel.Blue) * 16777619u;
            hash = (hash ^ (uint)pixel.Alpha) * 16777619u;
            index++;
        }
        return hash;
    }
}
