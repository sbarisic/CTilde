namespace System;

public struct Vec3
{
    public float X;
    public float Y;
    public float Z;

    public Vec3()
    {
        X = 0.0f;
        Y = 0.0f;
        Z = 0.0f;
    }

    public Vec3(float value)
    {
        X = value;
        Y = value;
        Z = value;
    }

    public Vec3(float x, float y, float z)
    {
        X = x;
        Y = y;
        Z = z;
    }

    [NoAlloc]
    public static Vec3 Zero
    {
        get { return new Vec3(); }
    }

    [NoAlloc]
    public static Vec3 One
    {
        get { return new Vec3(1.0f); }
    }

    [NoAlloc]
    public static Vec3 UnitX
    {
        get { return new Vec3(1.0f, 0.0f, 0.0f); }
    }

    [NoAlloc]
    public static Vec3 UnitY
    {
        get { return new Vec3(0.0f, 1.0f, 0.0f); }
    }

    [NoAlloc]
    public static Vec3 UnitZ
    {
        get { return new Vec3(0.0f, 0.0f, 1.0f); }
    }

    [NoAlloc]
    public static Vec3 operator +(Vec3 value)
    {
        return value;
    }

    [NoAlloc]
    public static Vec3 operator -(Vec3 value)
    {
        return new Vec3(-value.X, -value.Y, -value.Z);
    }

    [NoAlloc]
    public static Vec3 operator +(Vec3 left, Vec3 right)
    {
        return new Vec3(left.X + right.X, left.Y + right.Y, left.Z + right.Z);
    }

    [NoAlloc]
    public static Vec3 operator -(Vec3 left, Vec3 right)
    {
        return new Vec3(left.X - right.X, left.Y - right.Y, left.Z - right.Z);
    }

    [NoAlloc]
    public static Vec3 operator *(Vec3 left, Vec3 right)
    {
        return new Vec3(left.X * right.X, left.Y * right.Y, left.Z * right.Z);
    }

    [NoAlloc]
    public static Vec3 operator /(Vec3 left, Vec3 right)
    {
        return new Vec3(left.X / right.X, left.Y / right.Y, left.Z / right.Z);
    }

    [NoAlloc]
    public static Vec3 operator *(Vec3 value, float scale)
    {
        return new Vec3(value.X * scale, value.Y * scale, value.Z * scale);
    }

    [NoAlloc]
    public static Vec3 operator *(float scale, Vec3 value)
    {
        return value * scale;
    }

    [NoAlloc]
    public static Vec3 operator /(Vec3 value, float scale)
    {
        return new Vec3(value.X / scale, value.Y / scale, value.Z / scale);
    }

    [NoAlloc]
    public float Dot(Vec3 other)
    {
        return X * other.X + Y * other.Y + Z * other.Z;
    }

    [NoAlloc]
    public Vec3 Cross(Vec3 other)
    {
        return new Vec3(
            Y * other.Z - Z * other.Y,
            Z * other.X - X * other.Z,
            X * other.Y - Y * other.X);
    }

    [NoAlloc]
    public float LengthSquared()
    {
        return Dot(this);
    }

    [NoAlloc]
    public float Length()
    {
        return Math.Sqrt(LengthSquared());
    }

    [NoAlloc]
    public Vec3 Normalize()
    {
        return this / Length();
    }
}
