<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ctilde</AssemblyName>
    <PackageId>CTilde.CommandLine</PackageId>
    <RootNamespace>CTilde.Cli</RootNamespace>
    <Version>0.15.0</Version>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CTilde/CTilde.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="data\programs\sample1.ct">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
